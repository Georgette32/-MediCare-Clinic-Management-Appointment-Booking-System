
using MediCare.Domain.Entities;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace MediCare.Infrastructure.Persistence.Configurations;

internal sealed class AppointmentReminderConfiguration
    : IEntityTypeConfiguration<AppointmentReminder>
{
    public void Configure(EntityTypeBuilder<AppointmentReminder> builder)
    {
        builder.ToTable("AppointmentReminders");

        builder.HasKey(r => r.Id);

        builder.Property(r => r.ScheduledForUtc)
            .IsRequired();

        builder.Property(r => r.Status)
            .HasConversion<int>()
            .IsRequired();

        builder.HasIndex(r => new { r.AppointmentId, r.ScheduledForUtc })
            .IsUnique();

        builder.HasIndex(r => new { r.Status, r.ScheduledForUtc });

        builder.HasOne<Appointment>()
            .WithMany()
            .HasForeignKey(r => r.AppointmentId)
            .OnDelete(DeleteBehavior.Cascade);
    }
}
