@{
    ViewData["Title"] = "Patient dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Patient dashboard</h1>
        <p class="text-secondary mb-0">Welcome to your MediCare patient area.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">Your health account</div>
            <div class="card-body">
                <p class="mb-3">
                    Keep your personal and medical information up to date so the clinic can serve you safely.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Profile">Update my profile</a>
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="Account" asp-action="ChangePassword">Change password</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Appointments</div>
            <div class="card-body">
                <p class="text-secondary mb-0">
                    Booking and appointment history are provided by the scheduling module. They will appear here once that
                    module is connected to the shared database.
                </p>
            </div>
        </div>
    </div>
</div>
