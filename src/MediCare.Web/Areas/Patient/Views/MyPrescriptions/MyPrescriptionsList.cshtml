@using MediCare.Application.DTOs.Prescriptions
@model IReadOnlyList<PrescriptionDto>
@{
    ViewData["Title"] = "My prescriptions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">My prescriptions</h1>
        <p class="text-secondary mb-0">Your prescriptions, newest first.</p>
    </div>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print</button>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">You do not have any prescriptions yet.</div>
}
else
{
    foreach (var prescription in Model)
    {
        <div class="card mb-3">
            <div class="card-header">
                @prescription.IssuedAtUtc.ToString("yyyy-MM-dd") UTC &middot; Dr. @prescription.DoctorName
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-3">
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Days</th>
                                <th>Instructions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in prescription.Items)
                            {
                                <tr>
                                    <td>@item.MedicationName</td>
                                    <td>@item.Dosage</td>
                                    <td>@item.Frequency</td>
                                    <td>@item.DurationInDays</td>
                                    <td>@item.Instructions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrWhiteSpace(prescription.Notes))
                {
                    <h2 class="h6 text-secondary">Notes</h2>
                    <p class="mb-0" style="white-space: pre-wrap;">@prescription.Notes</p>
                }
            </div>
        </div>
    }
}
