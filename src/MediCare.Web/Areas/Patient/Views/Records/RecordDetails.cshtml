@using MediCare.Application.DTOs.MedicalRecords
@model MedicalRecordDto
@{
    ViewData["Title"] = "Medical record";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Medical record</h1>
        <p class="text-secondary mb-0">
            @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC &middot; Dr. @Model.DoctorName
        </p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="card">
    <div class="card-body p-4">
        <h2 class="h6 text-secondary">Symptoms</h2>
        <p style="white-space: pre-wrap;">@Model.Symptoms</p>

        <h2 class="h6 text-secondary">Diagnosis</h2>
        <p style="white-space: pre-wrap;">@Model.Diagnosis</p>

        @if (!string.IsNullOrWhiteSpace(Model.TreatmentPlan))
        {
            <h2 class="h6 text-secondary">Treatment plan</h2>
            <p style="white-space: pre-wrap;">@Model.TreatmentPlan</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.DoctorNotes))
        {
            <h2 class="h6 text-secondary">Doctor notes</h2>
            <p class="mb-0" style="white-space: pre-wrap;">@Model.DoctorNotes</p>
        }
    </div>
</div>
