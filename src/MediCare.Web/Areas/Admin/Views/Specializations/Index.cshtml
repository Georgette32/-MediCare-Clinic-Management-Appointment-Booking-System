@model SpecializationListViewModel
@{
    ViewData["Title"] = "Specializations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Specializations</h1>
        <p class="text-secondary mb-0">Maintain the catalogue used during doctor registration.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New specialization</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Doctors</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Specializations.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary py-4">No specializations have been created yet.</td></tr>
            }
            @foreach (var specialization in Model.Specializations)
            {
                <tr>
                    <td class="fw-semibold">@specialization.Name</td>
                    <td class="text-secondary">@specialization.Description</td>
                    <td>@specialization.DoctorCount</td>
                    <td>
                        @if (specialization.IsActive)
                        {
                            <span class="badge badge-approved">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@specialization.Id">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@specialization.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                @(specialization.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                        @if (specialization.DoctorCount == 0)
                        {
                            <form asp-action="Delete" asp-route-id="@specialization.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this specialization?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
