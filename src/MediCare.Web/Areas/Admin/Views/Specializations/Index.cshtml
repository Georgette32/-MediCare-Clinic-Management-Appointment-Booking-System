@model SpecializationListViewModel
@{
    ViewData["Title"] = "Specializations";
    ViewData["PageTitle"] = "Specializations";
    ViewData["PageSubtitle"] = "Maintain the catalogue used during doctor registration.";
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Create">
        @await Html.PartialAsync("_Icon", "plus") New specialization
    </a>
}

<div class="card">
    <div class="mc-table-wrap">
        <table class="mc-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Doctors</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Specializations.Count == 0)
                {
                    <tr>
                        <td colspan="5">
                            <div class="mc-empty">
                                <span class="mc-empty-icon">@await Html.PartialAsync("_Icon", "clipboard")</span>
                                <h3>No specializations yet</h3>
                                <p>Add a specialization so doctors can choose it when they register.</p>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Create">Create the first one</a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var specialization in Model.Specializations)
                {
                    <tr>
                        <td class="mc-cell-title">@specialization.Name</td>
                        <td class="mc-cell-sub">@(string.IsNullOrWhiteSpace(specialization.Description) ? "—" : specialization.Description)</td>
                        <td><span class="mc-badge mc-badge--info">@specialization.DoctorCount</span></td>
                        <td>@await Html.PartialAsync("_StatusBadge", specialization.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            <div class="mc-actions">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@specialization.Id">Edit</a>
                                <form asp-action="ToggleActive" asp-route-id="@specialization.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        @(specialization.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                                @if (specialization.DoctorCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@specialization.Id" method="post" class="d-inline"
                                          data-confirm="Delete the '@specialization.Name' specialization?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="mc-card-foot">
        <span class="mc-hint">@Model.Specializations.Count specialization(s) in the catalogue. Inactive entries are hidden from doctor registration.</span>
    </div>
</div>
