@model SpecializationFormViewModel
@{
    ViewData["Title"] = "Edit specialization";
    ViewData["PageTitle"] = "Edit specialization";
    ViewData["PageSubtitle"] = "Update an existing entry in the doctor registration catalogue.";
}

@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="Index">
        @await Html.PartialAsync("_Icon", "arrow-right") Back to specializations
    </a>
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card">
            <div class="mc-card-head">
                <span class="mc-card-head-title">@await Html.PartialAsync("_Icon", "edit") Specialization details</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" novalidate>
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="mc-validation mc-validation--danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Cardiology" />
                        <span asp-validation-for="Name" class="mc-field-error"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="A short description (optional)"></textarea>
                        <span asp-validation-for="Description" class="mc-field-error"></span>
                    </div>

                    <div class="mc-form-actions">
                        <a asp-action="Index" class="small">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            @await Html.PartialAsync("_Icon", "check") Save changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
