@model DoctorDetailsDto
@{
    ViewData["Title"] = "Doctor details";
    ViewData["PageTitle"] = "Doctor details";
    ViewData["PageSubtitle"] = "Review the professional profile and manage approval and account state.";
}

@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="Index">
        @await Html.PartialAsync("_Icon", "arrow-right") Back to doctors
    </a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">
        @await Html.PartialAsync("_Icon", "edit") Edit account
    </a>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <span class="mc-icon-box mc-icon-box--lg mc-icon-box--soft-blue">@await Html.PartialAsync("_Icon", "doctor")</span>
                    <div class="flex-grow-1">
                        <h2 class="h4 mb-1">@Model.FullName</h2>
                        <p class="mc-hint mb-0">@Model.Email</p>
                    </div>
                    @await Html.PartialAsync("_StatusBadge", Model.ApprovalStatus.ToString())
                </div>
            </div>
        </div>

        <div class="card">
            <div class="mc-card-head">
                <span class="mc-card-head-title">@await Html.PartialAsync("_Icon", "stethoscope") Professional profile</span>
            </div>
            <div class="card-body p-4">
                <dl class="mc-kv">
                    <dt>Specialisation</dt><dd>@Model.Specialization</dd>
                    <dt>Licence number</dt><dd class="mc-text-mono">@Model.LicenseNumber</dd>
                    <dt>Consultation fee</dt><dd>@Model.ConsultationFee.ToString("C")</dd>
                    <dt>Experience</dt><dd>@Model.YearsOfExperience year(s)</dd>
                    <dt>Phone</dt><dd>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</dd>
                    <dt>Bio</dt><dd>@(string.IsNullOrWhiteSpace(Model.Bio) ? "Not provided" : Model.Bio)</dd>
                    <dt>Registered</dt><dd>@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>
                    <dt>Reviewed</dt><dd>@(Model.ReviewedAtUtc.HasValue ? Model.ReviewedAtUtc.Value.ToLocalTime().ToString("g") : "Not reviewed yet")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="mc-card-head">
                <span class="mc-card-head-title">@await Html.PartialAsync("_Icon", "shield") Status</span>
            </div>
            <div class="card-body p-4 d-grid gap-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="mc-hint">Approval</span>
                    @await Html.PartialAsync("_StatusBadge", Model.ApprovalStatus.ToString())
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="mc-hint">Account</span>
                    @await Html.PartialAsync("_StatusBadge", Model.IsActive ? "Active" : "Deactivated")
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="mc-hint">Email</span>
                    @await Html.PartialAsync("_StatusBadge", Model.EmailConfirmed ? "Confirmed" : "Unconfirmed")
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                {
                    <div class="mc-alert mc-alert--warning mb-0" role="alert">
                        <span class="mc-alert-icon">@await Html.PartialAsync("_Icon", "alert")</span>
                        <span><strong>Review note.</strong> @Model.RejectionReason</span>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="mc-card-head">
                <span class="mc-card-head-title">@await Html.PartialAsync("_Icon", "gear") Actions</span>
            </div>
            <div class="card-body p-4 d-grid gap-2">
                @if (Model.ApprovalStatus != DoctorApprovalStatus.Approved)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post"
                          data-confirm="Approve @Model.FullName and grant doctor dashboard access?">
                        <button type="submit" class="btn btn-success w-100">
                            @await Html.PartialAsync("_Icon", "check") Approve application
                        </button>
                    </form>
                }

                @if (Model.ApprovalStatus == DoctorApprovalStatus.Pending)
                {
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        @await Html.PartialAsync("_Icon", "x") Reject application
                    </button>
                }

                @if (Model.ApprovalStatus == DoctorApprovalStatus.Approved)
                {
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#suspendModal">
                        @await Html.PartialAsync("_Icon", "lock") Suspend doctor access
                    </button>
                }

                @if (Model.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post"
                          data-confirm="Deactivate this account? The doctor will be signed out immediately.">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            @await Html.PartialAsync("_Icon", "x-circle") Deactivate account
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-success w-100">
                            @await Html.PartialAsync("_Icon", "check-circle") Activate account
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                <input type="hidden" name="DoctorId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel">Reject application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mc-hint">The doctor will be notified. Provide a clear reason for the decision.</p>
                    <label class="form-label" for="rejectReason">Reason</label>
                    <textarea class="form-control" id="rejectReason" name="Reason" rows="3" required maxlength="1000"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject application</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="suspendModal" tabindex="-1" aria-labelledby="suspendModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Suspend" asp-route-id="@Model.Id" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="suspendModalLabel">Suspend doctor access</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mc-hint">Suspending revokes clinical dashboard access until an administrator approves the profile again.</p>
                    <label class="form-label" for="suspendReason">Reason</label>
                    <textarea class="form-control" id="suspendReason" name="reason" rows="3" required maxlength="1000"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-secondary">Suspend access</button>
                </div>
            </form>
        </div>
    </div>
</div>
