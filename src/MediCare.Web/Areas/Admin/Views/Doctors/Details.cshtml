@model DoctorDetailsDto
@{
    ViewData["Title"] = "Doctor details";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.FullName</h1>
        <p class="text-secondary mb-0">@Model.Email</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back to doctors</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit account</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Professional profile</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Specialization</dt>
                    <dd class="col-sm-8">@Model.Specialization</dd>

                    <dt class="col-sm-4">License number</dt>
                    <dd class="col-sm-8">@Model.LicenseNumber</dd>

                    <dt class="col-sm-4">Consultation fee</dt>
                    <dd class="col-sm-8">@Model.ConsultationFee.ToString("C")</dd>

                    <dt class="col-sm-4">Experience</dt>
                    <dd class="col-sm-8">@Model.YearsOfExperience year(s)</dd>

                    <dt class="col-sm-4">Bio</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Bio) ? "Not provided" : Model.Bio)</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</dd>

                    <dt class="col-sm-4">Registered</dt>
                    <dd class="col-sm-8">@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>

                    <dt class="col-sm-4">Reviewed</dt>
                    <dd class="col-sm-8">@(Model.ReviewedAtUtc.HasValue ? Model.ReviewedAtUtc.Value.ToLocalTime().ToString("g") : "Not reviewed yet")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Status</div>
            <div class="card-body">
                <p class="mb-2">
                    Approval:
                    <span class="badge badge-@Model.ApprovalStatus.ToString().ToLowerInvariant()">@Model.ApprovalStatus</span>
                </p>
                <p class="mb-2">
                    Account:
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-approved">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-rejected">Deactivated</span>
                    }
                </p>
                <p class="mb-0">
                    Email:
                    @if (Model.EmailConfirmed)
                    {
                        <span class="badge badge-approved">Confirmed</span>
                    }
                    else
                    {
                        <span class="badge badge-pending">Not confirmed</span>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                {
                    <div class="alert alert-warning mt-3 mb-0 small">@Model.RejectionReason</div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">Actions</div>
            <div class="card-body d-grid gap-2">
                @if (Model.ApprovalStatus != DoctorApprovalStatus.Approved)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-success w-100">Approve application</button>
                    </form>
                }

                @if (Model.ApprovalStatus == DoctorApprovalStatus.Pending)
                {
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">Reject application</button>
                }

                @if (Model.ApprovalStatus == DoctorApprovalStatus.Approved)
                {
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#suspendModal">Suspend doctor access</button>
                }

                @if (Model.IsActive)
                {
                    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100">Deactivate account</button>
                    </form>
                }
                else
                {
                    <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-success w-100">Activate account</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                <input type="hidden" name="DoctorId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel">Reject application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary">The doctor will be notified. Provide a clear reason.</p>
                    <label class="form-label" for="rejectReason">Reason</label>
                    <textarea class="form-control" id="rejectReason" name="Reason" rows="3" required maxlength="1000"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="suspendModal" tabindex="-1" aria-labelledby="suspendModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Suspend" asp-route-id="@Model.Id" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="suspendModalLabel">Suspend doctor access</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary">Suspending revokes clinical dashboard access until an administrator approves the profile again.</p>
                    <label class="form-label" for="suspendReason">Reason</label>
                    <textarea class="form-control" id="suspendReason" name="reason" rows="3" required maxlength="1000"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-secondary">Suspend</button>
                </div>
            </form>
        </div>
    </div>
</div>
