@model DoctorListViewModel
@{
    ViewData["Title"] = "Doctors";
    ViewData["PageTitle"] = "Doctors";
    ViewData["PageSubtitle"] = "Review applications and manage doctor accounts.";
    var pendingCount = ViewBag.PendingCount as int? ?? 0;
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Pending">
        @await Html.PartialAsync("_Icon", "clock") Pending applications
        @if (pendingCount > 0)
        {
            <span class="mc-nav-count ms-1">@pendingCount</span>
        }
    </a>
}

<div class="mc-filter-bar mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-5 col-lg-4">
            <label asp-for="Search" class="form-label">Search</label>
            <input asp-for="Search" class="form-control" placeholder="Name, email, licence or specialisation" />
        </div>
        <div class="col-md-3">
            <label asp-for="ApprovalStatus" class="form-label">Approval</label>
            <select asp-for="ApprovalStatus" asp-items="Html.GetEnumSelectList<DoctorApprovalStatus>()" class="form-select">
                <option value="">All statuses</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="IsActive" class="form-label">Account</label>
            <select asp-for="IsActive" class="form-select">
                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Deactivated</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">@await Html.PartialAsync("_Icon", "filter") Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="mc-table-wrap">
        <table class="mc-table">
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Specialisation</th>
                    <th>Licence</th>
                    <th>Status</th>
                    <th>Account</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Doctors.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6">
                            <div class="mc-empty">
                                <span class="mc-empty-icon">@await Html.PartialAsync("_Icon", "search")</span>
                                <h3>No doctors found</h3>
                                <p>No doctor profiles match the selected filters. Try clearing the search or changing the status.</p>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Index">Clear filters</a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var doctor in Model.Doctors.Items)
                {
                    <tr>
                        <td>
                            <div class="mc-cell-title">@doctor.FullName</div>
                            <div class="mc-cell-sub">@doctor.Email</div>
                        </td>
                        <td>@doctor.Specialization</td>
                        <td class="mc-text-mono">@doctor.LicenseNumber</td>
                        <td>@await Html.PartialAsync("_StatusBadge", doctor.ApprovalStatus.ToString())</td>
                        <td>@await Html.PartialAsync("_StatusBadge", doctor.IsActive ? "Active" : "Deactivated")</td>
                        <td>
                            <div class="mc-actions">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@doctor.Id">Details</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@doctor.Id">Edit</a>
                                @if (doctor.ApprovalStatus == DoctorApprovalStatus.Pending)
                                {
                                    <form asp-action="Approve" asp-route-id="@doctor.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="mc-card-foot mc-pager">
        <span class="mc-hint">
            @Model.Doctors.TotalCount doctor(s) &middot; page @Model.Doctors.Page of @Model.Doctors.TotalPages
        </span>
        <div class="btn-group btn-group-sm">
            <a class="btn btn-outline-secondary @(Model.Doctors.HasPrevious ? "" : "disabled")"
               asp-action="Index" asp-route-page="@(Model.Doctors.Page - 1)" asp-route-search="@Model.Search"
               asp-route-approvalStatus="@Model.ApprovalStatus" asp-route-isActive="@Model.IsActive">Previous</a>
            <a class="btn btn-outline-secondary @(Model.Doctors.HasNext ? "" : "disabled")"
               asp-action="Index" asp-route-page="@(Model.Doctors.Page + 1)" asp-route-search="@Model.Search"
               asp-route-approvalStatus="@Model.ApprovalStatus" asp-route-isActive="@Model.IsActive">Next</a>
        </div>
    </div>
</div>
