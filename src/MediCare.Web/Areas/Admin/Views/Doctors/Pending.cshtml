@model IReadOnlyList<DoctorListItemDto>
@{
    ViewData["Title"] = "Pending doctor applications";
    ViewData["PageTitle"] = "Pending applications";
    ViewData["PageSubtitle"] = "Approve or reject applications after reviewing the doctor's credentials.";
}

@section PageActions {
    <a class="btn btn-outline-secondary" asp-action="Index">
        @await Html.PartialAsync("_Icon", "list") All doctors
    </a>
}

@if (Model.Count == 0)
{
    <div class="card">
        <div class="mc-empty">
            <span class="mc-empty-icon">@await Html.PartialAsync("_Icon", "check-circle")</span>
            <h3>You're all caught up</h3>
            <p>There are no doctor applications waiting for review right now.</p>
            <a class="btn btn-outline-primary btn-sm" asp-action="Index">View all doctors</a>
        </div>
    </div>
}
else
{
    <div class="mc-alert mc-alert--warning mb-3" role="alert">
        <span class="mc-alert-icon">@await Html.PartialAsync("_Icon", "clock")</span>
        <span><strong>@Model.Count application(s) awaiting review.</strong> Open a profile to verify the licence before approving.</span>
    </div>

    <div class="card">
        <div class="mc-table-wrap">
            <table class="mc-table">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Specialisation</th>
                        <th>Licence</th>
                        <th>Experience</th>
                        <th>Submitted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td>
                                <div class="mc-cell-title">@doctor.FullName</div>
                                <div class="mc-cell-sub">@doctor.Email</div>
                            </td>
                            <td>@doctor.Specialization</td>
                            <td class="mc-text-mono">@doctor.LicenseNumber</td>
                            <td>@doctor.YearsOfExperience year(s)</td>
                            <td>@doctor.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>
                                <div class="mc-actions">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@doctor.Id">Review</a>
                                    <form asp-action="Approve" asp-route-id="@doctor.Id" method="post" class="d-inline"
                                          data-confirm="Approve @doctor.FullName and grant doctor dashboard access?">
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mc-card-foot">
            <span class="mc-hint">Applications are reviewed in line with the clinic's doctor onboarding policy.</span>
        </div>
    </div>
}
