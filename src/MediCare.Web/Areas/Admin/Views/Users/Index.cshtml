@model UserListViewModel
@{
    ViewData["Title"] = "Users";
    ViewData["PageTitle"] = "Users & roles";
    ViewData["PageSubtitle"] = "Manage account status and roles. Role changes are enforced server-side.";
    var roles = new[] { Roles.Patient, Roles.Doctor, Roles.Admin };
}

<div class="mc-filter-bar mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-5 col-lg-4">
            <label asp-for="Search" class="form-label">Search</label>
            <input asp-for="Search" class="form-control" placeholder="Name, email or phone" />
        </div>
        <div class="col-md-3">
            <label asp-for="Role" class="form-label">Role</label>
            <select asp-for="Role" class="form-select">
                <option value="">All roles</option>
                @foreach (var role in roles)
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="IsActive" class="form-label">Account</label>
            <select asp-for="IsActive" class="form-select">
                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Deactivated</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">@await Html.PartialAsync("_Icon", "filter") Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="mc-table-wrap">
        <table class="mc-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Roles</th>
                    <th>Account</th>
                    <th>Registered</th>
                    <th>Change role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6">
                            <div class="mc-empty">
                                <span class="mc-empty-icon">@await Html.PartialAsync("_Icon", "search")</span>
                                <h3>No users found</h3>
                                <p>No accounts match the selected filters.</p>
                                <a class="btn btn-outline-primary btn-sm" asp-action="Index">Clear filters</a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var user in Model.Users.Items)
                {
                    <tr>
                        <td>
                            <div class="mc-cell-title">@user.FullName</div>
                            <div class="mc-cell-sub">@user.Email</div>
                            @if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                            {
                                <div class="mc-cell-sub">@user.PhoneNumber</div>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var role in user.Roles)
                                {
                                    @await Html.PartialAsync("_StatusBadge", role)
                                }
                            </div>
                        </td>
                        <td>
                            <div class="d-flex flex-column gap-1 align-items-start">
                                @await Html.PartialAsync("_StatusBadge", user.IsActive ? "Active" : "Deactivated")
                                @if (!user.EmailConfirmed)
                                {
                                    @await Html.PartialAsync("_StatusBadge", "Unconfirmed")
                                }
                            </div>
                        </td>
                        <td>@user.CreatedAtUtc.ToLocalTime().ToString("d")</td>
                        <td>
                            <form asp-action="ChangeRole" method="post" class="d-flex gap-1"
                                  data-confirm="Change the role for @user.FullName?">
                                <input type="hidden" name="UserId" value="@user.Id" />
                                <select name="Role" class="form-select form-select-sm" style="width:auto;">
                                    @foreach (var role in roles)
                                    {
                                        <option value="@role" selected="@(user.Roles.Contains(role, StringComparer.OrdinalIgnoreCase))">@role</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                            </form>
                        </td>
                        <td>
                            <div class="mc-actions">
                                @if (user.IsActive)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@user.Id" method="post" class="d-inline"
                                          data-confirm="Deactivate @user.FullName? They will be signed out immediately.">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@user.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="mc-card-foot mc-pager">
        <span class="mc-hint">@Model.Users.TotalCount user(s) &middot; page @Model.Users.Page of @Model.Users.TotalPages</span>
        <div class="btn-group btn-group-sm">
            <a class="btn btn-outline-secondary @(Model.Users.HasPrevious ? "" : "disabled")"
               asp-action="Index" asp-route-page="@(Model.Users.Page - 1)" asp-route-search="@Model.Search"
               asp-route-role="@Model.Role" asp-route-isActive="@Model.IsActive">Previous</a>
            <a class="btn btn-outline-secondary @(Model.Users.HasNext ? "" : "disabled")"
               asp-action="Index" asp-route-page="@(Model.Users.Page + 1)" asp-route-search="@Model.Search"
               asp-route-role="@Model.Role" asp-route-isActive="@Model.IsActive">Next</a>
        </div>
    </div>
</div>
