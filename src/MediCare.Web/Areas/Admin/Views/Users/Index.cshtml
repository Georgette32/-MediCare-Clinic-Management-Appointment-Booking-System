@model UserListViewModel
@{
    ViewData["Title"] = "Users";
    var roles = new[] { Roles.Patient, Roles.Doctor, Roles.Admin };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Users</h1>
        <p class="text-secondary mb-0">Manage account status and roles. Role changes are enforced server-side.</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label asp-for="Search" class="form-label">Search</label>
                <input asp-for="Search" class="form-control" placeholder="Name, email or phone" />
            </div>
            <div class="col-md-3">
                <label asp-for="Role" class="form-label">Role</label>
                <select asp-for="Role" class="form-select">
                    <option value="">All roles</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="IsActive" class="form-label">Account</label>
                <select asp-for="IsActive" class="form-select">
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false">Deactivated</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Roles</th>
                    <th>Account</th>
                    <th>Registered</th>
                    <th>Role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Users.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-4">No users match the selected filters.</td></tr>
            }
            @foreach (var user in Model.Users.Items)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@user.FullName</div>
                        <div class="small text-secondary">@user.Email</div>
                    </td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="badge bg-secondary me-1">@role</span>
                        }
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge badge-approved">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-rejected">Deactivated</span>
                        }
                        @if (!user.EmailConfirmed)
                        {
                            <span class="badge badge-pending">Email unconfirmed</span>
                        }
                    </td>
                    <td>@user.CreatedAtUtc.ToLocalTime().ToString("d")</td>
                    <td>
                        <form asp-action="ChangeRole" method="post" class="d-flex gap-1">
                            <input type="hidden" name="UserId" value="@user.Id" />
                            <select name="Role" class="form-select form-select-sm">
                                @foreach (var role in roles)
                                {
                                    <option value="@role" selected="@(user.Roles.Contains(role, StringComparer.OrdinalIgnoreCase))">@role</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                        </form>
                    </td>
                    <td class="text-end">
                        @if (user.IsActive)
                        {
                            <form asp-action="Deactivate" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activate" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="small text-secondary">@Model.Users.TotalCount user(s) &middot; page @Model.Users.Page of @Model.Users.TotalPages</span>
        <div class="btn-group">
            <a class="btn btn-sm btn-outline-secondary @(Model.Users.HasPrevious ? "" : "disabled")"
               asp-action="Index" asp-route-page="@(Model.Users.Page - 1)" asp-route-search="@Model.Search"
               asp-route-role="@Model.Role" asp-route-isActive="@Model.IsActive">Previous</a>
            <a class="btn btn-sm btn-outline-secondary @(Model.Users.HasNext ? "" : "disabled")"
               asp-action="Index" asp-route-page="@(Model.Users.Page + 1)" asp-route-search="@Model.Search"
               asp-route-role="@Model.Role" asp-route-isActive="@Model.IsActive">Next</a>
        </div>
    </div>
</div>
