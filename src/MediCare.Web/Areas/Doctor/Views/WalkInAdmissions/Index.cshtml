@model MediCare.Web.ViewModels.Doctor.WalkInAdmissionsViewModel
@{
    ViewData["Title"] = "Walk-in admission requests";
    ViewData["PageSubtitle"] = "Review patients asking to join today's clinic queue.";
}

@if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
{
    <div class="alert mc-alert mc-alert--info" role="status">@status</div>
}

<section class="mc-card">
    <div class="mc-card-head">
        <div>
            <p class="mc-eyebrow">Clinic queue</p>
            <h2 class="mc-card-head-title">Pending requests</h2>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Refresh</a>
    </div>
    <div class="mc-card-body p-0">
        @if (Model.Requests.Count == 0)
        {
            <div class="mc-empty">
                <span class="mc-empty-icon">@await Html.PartialAsync("_Icon", "users")</span>
                <h3>No pending requests</h3>
                <p>Walk-in admission requests will appear here when reception sends them.</p>
            </div>
        }
        else
        {
            <div class="mc-table-wrap">
                <table class="mc-table align-middle">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Queue #</th>
                            <th>Arrived (UTC)</th>
                            <th>Expires (UTC)</th>
                            <th class="text-end">Decision</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.Requests)
                        {
                            <tr>
                                <td>
                                    <span class="mc-cell-title">@request.PatientName</span>
                                </td>
                                <td>@request.QueueSequence</td>
                                <td>@request.ArrivedAtUtc.ToString("g")</td>
                                <td>@request.ExpiresAtUtc.ToString("g")</td>
                                <td>
                                    <div class="mc-actions justify-content-end">
                                        <form asp-action="Decide" method="post">
                                            <input type="hidden" name="ApprovalId" value="@request.ApprovalId" />
                                            <input type="hidden" name="Approve" value="true" />
                                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                        <form asp-action="Decide" method="post">
                                            <input type="hidden" name="ApprovalId" value="@request.ApprovalId" />
                                            <input type="hidden" name="Approve" value="false" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
