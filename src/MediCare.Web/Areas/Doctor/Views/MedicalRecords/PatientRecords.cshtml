@using MediCare.Web.ViewModels.Doctor
@model DoctorPatientRecordsViewModel
@{
    ViewData["Title"] = "Patient records";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.PatientName</h1>
        <p class="text-secondary mb-0">Medical history, newest first.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Create" asp-route-patientId="@Model.PatientProfileId">New record</a>
    </div>
</div>

@if (Model.Records.Count == 0)
{
    <div class="alert alert-info">This patient has no medical records yet.</div>
}
else
{
    foreach (var record in Model.Records)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@record.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC &middot; Dr. @record.DoctorName</span>
                <span class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-patientId="@Model.PatientProfileId" asp-route-id="@record.Id">Edit</a>
                    <form asp-action="Delete" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this medical record?');">
                        <input type="hidden" name="id" value="@record.Id" />
                        <input type="hidden" name="patientId" value="@Model.PatientProfileId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </span>
            </div>
            <div class="card-body">
                <h2 class="h6 text-secondary">Symptoms</h2>
                <p style="white-space: pre-wrap;">@record.Symptoms</p>

                <h2 class="h6 text-secondary">Diagnosis</h2>
                <p style="white-space: pre-wrap;">@record.Diagnosis</p>

                @if (!string.IsNullOrWhiteSpace(record.TreatmentPlan))
                {
                    <h2 class="h6 text-secondary">Treatment plan</h2>
                    <p style="white-space: pre-wrap;">@record.TreatmentPlan</p>
                }

                @if (!string.IsNullOrWhiteSpace(record.DoctorNotes))
                {
                    <h2 class="h6 text-secondary">Doctor notes</h2>
                    <p class="mb-0" style="white-space: pre-wrap;">@record.DoctorNotes</p>
                }
            </div>
        </div>
    }
}
