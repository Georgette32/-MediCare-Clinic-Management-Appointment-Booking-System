@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <span class="mc-eyebrow">Your information</span>
        <h1 class="h3 mt-1 mb-3">Privacy Policy</h1>
        <div class="card">
            <div class="card-body p-4">
                <p class="mc-hint">
                    MediCare stores only the information needed to coordinate your care and manage clinic accounts.
                    Access is restricted by role, and administrative actions are protected by server-side authorization.
                </p>
                <dl class="mc-kv mt-4">
                    <dt>What we store</dt>
                    <dd>Account details, contact information and the profile fields you choose to provide.</dd>
                    <dt>Who can see it</dt>
                    <dd>You and authorised clinic staff. Doctor profiles are visible to administrators for approval.</dd>
                    <dt>How it is protected</dt>
                    <dd>Authentication, role-based policies, anti-forgery protection and deactivation enforcement.</dd>
                    <dt>Your control</dt>
                    <dd>You can update your profile and change your password at any time from your account pages.</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
