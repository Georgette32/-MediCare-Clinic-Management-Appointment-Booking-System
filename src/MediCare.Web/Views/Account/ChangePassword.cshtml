@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["PageTitle"] = "Change password";
    ViewData["PageSubtitle"] = "Use a strong, unique password to protect your account.";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="mc-icon-box mc-icon-box--lg">@await Html.PartialAsync("_Icon", "key")</span>
                    <div>
                        <h2 class="h5 mb-0">Update your password</h2>
                        <span class="mc-hint">You will stay signed in on this device.</span>
                    </div>
                </div>

                <form asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="mc-validation mc-validation--danger"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Current password" data-mc-password />
                        <span asp-validation-for="CurrentPassword" class="mc-field-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="New password" data-mc-password />
                        <div class="mc-password-meter" data-mc-password-meter><span></span><span></span><span></span><span></span></div>
                        <span asp-validation-for="NewPassword" class="mc-field-error"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat new password" />
                        <span asp-validation-for="ConfirmPassword" class="mc-field-error"></span>
                    </div>

                    <p class="mc-hint">Passwords need at least 8 characters, including an uppercase letter, a lowercase letter and a digit.</p>

                    <div class="mc-form-actions">
                        <a asp-action="Profile">Back to profile</a>
                        <button type="submit" class="btn btn-primary">
                            @await Html.PartialAsync("_Icon", "shield") Update password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
