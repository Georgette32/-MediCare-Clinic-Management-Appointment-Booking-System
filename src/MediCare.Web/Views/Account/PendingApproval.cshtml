@model DoctorDetailsDto
@{
    ViewData["Title"] = "Application status";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Doctor application status</div>
            <div class="card-body p-4">
                @if (Model.ApprovalStatus == DoctorApprovalStatus.Pending)
                {
                    <div class="alert alert-warning mb-4">
                        Your application is waiting for administrator review. You will receive an email once it is processed.
                    </div>
                }
                else if (Model.ApprovalStatus == DoctorApprovalStatus.Rejected)
                {
                    <div class="alert alert-danger mb-4">
                        Your application was rejected.
                        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                        {
                            <span>Reason: @Model.RejectionReason</span>
                        }
                    </div>
                }
                else if (Model.ApprovalStatus == DoctorApprovalStatus.Suspended)
                {
                    <div class="alert alert-secondary mb-4">
                        Your doctor access is suspended.
                        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                        {
                            <span>Reason: @Model.RejectionReason</span>
                        }
                    </div>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Specialization</dt>
                    <dd class="col-sm-8">@Model.Specialization</dd>

                    <dt class="col-sm-4">License number</dt>
                    <dd class="col-sm-8">@Model.LicenseNumber</dd>

                    <dt class="col-sm-4">Approval status</dt>
                    <dd class="col-sm-8"><span class="badge badge-@Model.ApprovalStatus.ToString().ToLowerInvariant()">@Model.ApprovalStatus</span></dd>

                    <dt class="col-sm-4">Submitted</dt>
                    <dd class="col-sm-8">@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>
                </dl>

                <div class="mt-4">
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Profile">My profile</a>
                </div>
            </div>
        </div>
    </div>
</div>
