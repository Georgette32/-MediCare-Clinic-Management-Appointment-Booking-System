@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Account</div>
            <div class="card-body">
                <p class="mb-1 fw-semibold">@Model.FullName</p>
                <p class="text-secondary mb-3">@Model.Email</p>
                <div class="mb-2">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge bg-secondary me-1">@role</span>
                    }
                </div>
                <p class="mb-1 small">
                    Status:
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-approved">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-rejected">Deactivated</span>
                    }
                </p>
                <p class="mb-0 small">
                    Email:
                    @if (Model.EmailConfirmed)
                    {
                        <span class="badge badge-approved">Confirmed</span>
                    }
                    else
                    {
                        <span class="badge badge-pending">Not confirmed</span>
                    }
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Profile information</div>
            <div class="card-body p-4">
                <form asp-action="Profile" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        @if (Model.IsPatient)
                        {
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label"></label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label"></label>
                                <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BloodType" class="form-label"></label>
                                <input asp-for="BloodType" class="form-control" />
                                <span asp-validation-for="BloodType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmergencyContact" class="form-label"></label>
                                <input asp-for="EmergencyContact" class="form-control" />
                                <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label"></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="ChangePassword">Change password</a>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
