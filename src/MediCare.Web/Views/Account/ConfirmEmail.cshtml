@model ConfirmEmailViewModel
@{
    ViewData["Title"] = "Email confirmation";
    var icon = Model.Succeeded ? "check-circle" : "alert";
    var tone = Model.Succeeded ? "ok" : "error";
}

<div class="mc-auth-card mc-auth-state">
    <div class="mc-auth-state-icon mc-auth-state-icon--@tone">@await Html.PartialAsync("_Icon", icon)</div>
    <h1>@(Model.Succeeded ? "Email confirmed" : "Confirmation failed")</h1>
    <p class="mc-auth-subtitle @(Model.Succeeded ? "text-success" : "text-danger")">@Model.Message</p>
    <a class="btn btn-primary w-100" asp-action="Login">@(Model.Succeeded ? "Sign in" : "Back to sign in")</a>
</div>
