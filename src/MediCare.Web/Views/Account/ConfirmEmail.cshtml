@model ConfirmEmailViewModel
@{
    ViewData["Title"] = "Email confirmation";
}

<div class="auth-card text-center">
    <div class="card">
        <div class="card-body p-5">
            <h1 class="h3 mb-3">@(Model.Succeeded ? "Email confirmed" : "Confirmation failed")</h1>
            <p class="@(Model.Succeeded ? "text-success" : "text-danger")">@Model.Message</p>
            @if (Model.Succeeded)
            {
                <a class="btn btn-primary" asp-action="Login">Sign in</a>
            }
            else
            {
                <a class="btn btn-outline-primary" asp-action="Login">Back to sign in</a>
            }
        </div>
    </div>
</div>
