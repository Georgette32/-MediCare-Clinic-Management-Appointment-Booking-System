@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="mc-auth-card">
    <div class="mc-auth-state-icon mc-auth-state-icon--info">@await Html.PartialAsync("_Icon", "key")</div>
    <h1>Reset your password</h1>
    <p class="mc-auth-subtitle">Enter the email address linked to your account. If it exists, we will send you a reset link.</p>

    <form asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="mc-validation mc-validation--danger"></div>
        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
            <span asp-validation-for="Email" class="mc-field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">
            Send reset link @await Html.PartialAsync("_Icon", "arrow-right")
        </button>
    </form>

    <div class="mc-auth-alt small">
        <a asp-action="Login">&larr; Back to sign in</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
