@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card">
    <div class="card">
        <div class="card-header">Reset your password</div>
        <div class="card-body p-4">
            <p class="text-secondary">Enter the email address associated with your account. If the account exists, we will send a reset link.</p>
            <form asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Login">Back to sign in</a>
                    <button type="submit" class="btn btn-primary">Send reset link</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
