@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <div class="card">
        <div class="card-header">Sign in to MediCare</div>
        <div class="card-body p-4">
            @if (ViewData["Message"] is string message)
            {
                <div class="alert alert-warning">@message</div>
            }

            <form asp-action="Login" method="post" novalidate>
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="ForgotPassword">Forgot your password?</a>
                    <button type="submit" class="btn btn-primary">Sign in</button>
                </div>
            </form>

            <hr />
            <div class="d-flex justify-content-between small">
                <a asp-action="RegisterPatient">Create a patient account</a>
                <a asp-action="RegisterDoctor">Apply as a doctor</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
