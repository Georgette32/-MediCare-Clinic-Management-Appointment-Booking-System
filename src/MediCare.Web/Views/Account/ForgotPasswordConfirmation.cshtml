@{
    ViewData["Title"] = "Check your email";
}

<div class="mc-auth-card mc-auth-state">
    <div class="mc-auth-state-icon mc-auth-state-icon--info">@await Html.PartialAsync("_Icon", "mail")</div>
    <h1>Check your email</h1>
    <p class="mc-auth-subtitle">If an account exists for that address, a password reset link has been sent. The link expires in two hours.</p>
    <a class="btn btn-primary w-100" asp-action="Login">Back to sign in</a>
    <p class="mc-hint mt-3 mb-0">Did not receive it? Check your spam folder or contact the clinic administrator.</p>
</div>
