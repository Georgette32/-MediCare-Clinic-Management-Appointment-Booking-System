@{
    ViewData["Title"] = "Check your email";
}

<div class="auth-card text-center">
    <div class="card">
        <div class="card-body p-5">
            <h1 class="h3 mb-3">Check your email</h1>
            <p class="text-secondary">If an account exists for that address, a password reset link has been sent. The link expires in two hours.</p>
            <a class="btn btn-primary" asp-action="Login">Back to sign in</a>
        </div>
    </div>
</div>
