@using MediCare.Application.Common.Security
@using System.Linq
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var csrf = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var displayName = User.FindFirst(CustomClaimTypes.FullName)?.Value ?? User.Identity?.Name ?? string.Empty;
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "MC";
    }

    string DashboardArea() => User.IsInRole(Roles.Admin) ? "Admin" : User.IsInRole(Roles.Doctor) ? "Doctor" : "Patient";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MediCare — a secure clinic management and appointment platform for patients, doctors and administrators." />
    <meta name="csrf-token" content="@csrf.RequestToken" />
    <title>@ViewData["Title"] - MediCare</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MediCare.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="mc-public-header">
        <nav class="navbar navbar-expand-lg container" aria-label="Main navigation">
            <a class="mc-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="mc-brand-mark">@await Html.PartialAsync("_Icon", "cross")</span>
                MediCare
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"
                    aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="publicNav">
                <ul class="navbar-nav me-auto mc-public-nav">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Home" && action == "Index" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#workflow">How it works</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="@DashboardArea()" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav align-items-lg-center mc-public-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-lg-1">
                            @await Html.PartialAsync("_NotificationBell")
                        </li>
                        <li class="nav-item dropdown">
                            <button type="button" class="mc-user-menu dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="mc-header-avatar">@initials</span>
                                <span class="d-none d-lg-block">@displayName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><span class="dropdown-header">Signed in as @displayName</span></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">My profile</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                                @if (User.IsInRole(Roles.Doctor))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="PendingApproval">Application status</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-lg-2">
                            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="RegisterPatient">Create account</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 mc-public-main">
        @await Html.PartialAsync("_Alerts")
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mc-public-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year MediCare Clinic Management</span>
            <span class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <span>Built with ASP.NET Core MVC</span>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
