@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-9 col-lg-7 text-center">
        <div class="mc-auth-state-icon mc-auth-state-icon--error mx-auto">@await Html.PartialAsync("_Icon", "alert")</div>
        <h1 class="h3 mt-3 mb-2">Something went wrong</h1>
        <p class="mc-hint mb-4">An error occurred while processing your request. Please try again in a moment.</p>

        @if (Model.ShowRequestId)
        {
            <p class="mc-hint small">Request ID: <code class="mc-text-mono">@Model.RequestId</code></p>
        }

        <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Return home</a>
    </div>
</div>
