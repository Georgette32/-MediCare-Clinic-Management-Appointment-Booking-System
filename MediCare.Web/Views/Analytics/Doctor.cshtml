@using MediCare.Application.Analytics
@model MediCare.Web.Models.AnalyticsPageViewModel
@{
    ViewData["Title"] = Model.IsOwnStatistics ? "My statistics" : "Doctor analytics";
    var doc = Model.Doctor;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-1">
    <div>
        <h1 class="mb-1">@(Model.IsOwnStatistics ? "My statistics" : (doc?.DoctorName ?? "Doctor analytics"))</h1>
        <p class="text-secondary mb-0">How @(Model.IsOwnStatistics ? "your" : "this doctor’s") clinic did on past days, from the times recorded at the desk.</p>
    </div>
    @if (!Model.IsOwnStatistics)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-from="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate.ToString("yyyy-MM-dd")">All doctors</a>
    }
</div>

<form method="get" class="mc-panel mc-card d-flex flex-wrap gap-3 align-items-end my-3">
    @if (!Model.IsOwnStatistics && Model.SelectedDoctorId is { } doctorId)
    {
        <input type="hidden" name="id" value="@doctorId" />
    }
    <div>
        <label class="form-label" for="from">From</label>
        <input class="form-control" type="date" id="from" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="form-label" for="to">To</label>
        <input class="form-control" type="date" id="to" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
    </div>
    <button class="btn btn-primary" type="submit">Show these days</button>
</form>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
else if (doc is not null)
{
    var m = doc.Metrics;
    <div class="mc-stats mb-4">
        <div class="mc-panel mc-stat"><span class="mc-chip mc-chip-teal">@UiIcons.Icon("users")</span><div><b class="mc-num">@m.ArrivalsCount</b><span>Patients who came · @m.ServedCount seen</span></div></div>
        <div class="mc-panel mc-stat"><span class="mc-chip mc-chip-cobalt">@UiIcons.Icon("gauge")</span><div><b class="mc-num">@(m.Overloaded ? "Overloaded" : (m.Rho is null ? "-" : $"{m.Rho.Value * 100:0}%"))</b><span>Workload: arrivals compared with capacity</span></div></div>
        <div class="mc-panel mc-stat"><span class="mc-chip mc-chip-amber">@UiIcons.Icon("clock")</span><div><b class="mc-num">@AnalyticsPageViewModel.Minutes(m.MeasuredWqMinutes)</b><span>Average wait · @AnalyticsPageViewModel.Minutes(m.MeasuredWsMinutes) in the clinic</span></div></div>
        <div class="mc-panel mc-stat"><span class="mc-chip mc-chip-vermilion">@UiIcons.Icon("x")</span><div><b class="mc-num">@AnalyticsPageViewModel.Percent(m.NoShowRate)</b><span>No-shows · @m.NoShowCount of @m.NoShowDenominator</span></div></div>
    </div>

    <section class="mc-panel mc-card mb-4">
        <div class="mc-card-head"><h2>The numbers, explained</h2></div>
        @await Html.PartialAsync("~/Views/Analytics/_QueueingMetrics.cshtml", m)
    </section>

    <section class="mc-panel mc-card mb-4">
        <div class="mc-card-head"><h2>Busy hours: booked vs actual arrivals</h2></div>
        <p class="small text-secondary">Totals for each hour of the day over the period. Grey bars are booked appointment starts; teal bars are patients who actually arrived. Use it to see which hours need more slots.</p>
        @await Html.PartialAsync("~/Views/Analytics/_HourlyChart.cshtml", doc.Hours)
    </section>

    <p class="small text-secondary">Visits cancelled because the clinic was unavailable are left out. Full definitions are in docs/ANALYTICS_MODEL.md.</p>
}
