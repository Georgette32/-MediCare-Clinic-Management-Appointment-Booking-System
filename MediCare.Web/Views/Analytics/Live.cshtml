@using MediCare.Application.Analytics
@model MediCare.Web.Models.AnalyticsPageViewModel
@{
    ViewData["Title"] = "Live operations";
    var live = Model.Live!;
}

<div data-refresh-seconds="30">
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="mb-1">Live board</h1>
        <p class="text-secondary mb-0">
            <span class="badge text-bg-info">Live</span>
            Today so far, as of @ClinicTime.Format(live.AsOfUtc, ClinicZone, "h:mm tt"). Updates every 30 seconds.
        </p>
    </div>
    <form method="get" class="mc-queue-doctor">
        <label class="form-label" for="doctorId">Doctor</label>
        <select class="form-select" id="doctorId" name="doctorId" data-autosubmit>
            <option value="">All active doctors</option>
            @foreach (var doctor in Model.Doctors)
            {
                <option value="@doctor.DoctorId" selected="@(doctor.DoctorId == Model.SelectedDoctorId)">@doctor.FullName</option>
            }
        </select>
        <noscript><button class="btn btn-sm btn-primary mt-2" type="submit">Show</button></noscript>
    </form>
</div>

@if (live.Rows.Count == 0)
{
    <p class="mc-empty">No active doctors to show.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th class="text-end">Waiting</th>
                    <th class="text-end">Called</th>
                    <th class="text-end">With doctor</th>
                    <th class="text-end" title="The longest anyone is waiting right now">Longest wait</th>
                    <th class="text-end" title="New patients per hour since opening">Arrivals / hour</th>
                    <th class="text-end" title="Patients the doctor can see per hour">Can see / hour</th>
                    <th>Workload</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in live.Rows)
                {
                    var m = row.MetricsSoFar;
                    <tr>
                        <td class="text-nowrap fw-medium">@row.DoctorName</td>
                        <td class="text-end fw-semibold">@row.WaitingNow</td>
                        <td class="text-end">@row.CalledNow</td>
                        <td class="text-end">@row.InConsultation</td>
                        <td class="text-end">@AnalyticsPageViewModel.Minutes(row.LongestCurrentWaitMinutes)</td>
                        <td class="text-end">@AnalyticsPageViewModel.PerHour(m.LambdaPerHour)</td>
                        <td class="text-end">@AnalyticsPageViewModel.PerHour(m.MuPerHour)</td>
                        <td>
                            @if (m.Rho is null && !m.Overloaded)
                            {
                                <span class="badge text-bg-secondary" title="No finished consultations yet today">Not enough data yet</span>
                            }
                            else
                            {
                                <partial name="_Workload" model="(m.Rho, m.Overloaded)" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-secondary">
        <b>Workload</b> compares how fast patients have arrived since opening with how many the doctor can see per hour.
        At 100% or more the waiting line is growing: consider an extension or moving walk-ins to another doctor.
        Today’s numbers cover only part of the day, so they can differ from the past-days view.
    </p>
}
</div>
