@using MediCare.Application.Analytics
@using MediCare.Web.Models
@model MediCare.Application.Analytics.DoctorQueueingMetrics
@{
    var m = Model;
}

<div class="mc-measures">
    <section>
        <h3>Patients</h3>
        <dl>
            <div><dt>Patients who came</dt><dd>@m.ArrivalsCount</dd><span>Every time a patient joined the queue in this period</span></div>
            <div><dt>Patients seen</dt><dd>@m.ServedCount</dd><span>Finished consultations with complete times</span></div>
            <div><dt>Clinic open time</dt><dd>@m.OpenHours.ToString("0.0") hours</dd><span>Working hours minus breaks, extra hours included</span></div>
            <div><dt>No-shows</dt><dd>@AnalyticsPageViewModel.Percent(m.NoShowRate)</dd><span>@m.NoShowCount of @m.NoShowDenominator appointments were missed</span></div>
            <div><dt>Walk-ins seen</dt><dd>@m.WalkInCompletedCount</dd><span>@AnalyticsPageViewModel.PerHour(m.WalkInPerHour) on average</span></div>
        </dl>
    </section>

    <section>
        <h3>Speed and workload</h3>
        <dl>
            <div><dt>New patients per hour</dt><dd>@AnalyticsPageViewModel.PerHour(m.LambdaPerHour)</dd><span>How fast patients arrive</span></div>
            <div><dt>Patients the doctor can see per hour</dt><dd>@AnalyticsPageViewModel.PerHour(m.MuPerHour)</dd><span>Based on the average consultation</span></div>
            <div><dt>Average consultation</dt><dd>@AnalyticsPageViewModel.Minutes(m.MeanServiceMinutes)</dd><span>From @m.ServiceSampleCount finished consultations</span></div>
            <div>
                <dt>Workload</dt>
                <dd>
                    @if (m.Overloaded)
                    {
                        <span class="badge text-bg-danger">Overloaded</span>
                    }
                    else
                    {
                        @AnalyticsPageViewModel.Workload(m.Rho)
                    }
                </dd>
                <span>Arrivals compared with what the doctor can see. 100% or more means the line keeps growing.</span>
            </div>
            <div><dt>Time spent with patients</dt><dd>@AnalyticsPageViewModel.Percent(m.Utilization)</dd><span>Share of open time the doctor was in consultations</span></div>
        </dl>
    </section>

    <section>
        <h3>Waiting</h3>
        <dl>
            <div><dt>Average wait before the doctor</dt><dd>@AnalyticsPageViewModel.Minutes(m.MeasuredWqMinutes)</dd><span>From joining the queue to the consultation starting</span></div>
            <div><dt>Average total time in the clinic</dt><dd>@AnalyticsPageViewModel.Minutes(m.MeasuredWsMinutes)</dd><span>From joining the queue to leaving the doctor</span></div>
            <div><dt>Patients waiting, on average</dt><dd>@AnalyticsPageViewModel.Patients(m.MeasuredLq)</dd><span>At any moment the clinic was open</span></div>
            <div><dt>Patients in the clinic, on average</dt><dd>@AnalyticsPageViewModel.Patients(m.MeasuredLs)</dd><span>Waiting or with the doctor</span></div>
        </dl>
    </section>
</div>

<details class="mc-measures-more">
    <summary>How reliable are these numbers?</summary>
    <div class="mc-measures">
        <section>
            <h3>Consistency check</h3>
            <p class="small text-secondary">The average number of patients waiting is measured twice, in two independent ways. Close results mean the times recorded at the desk are reliable.</p>
            <dl>
                <div><dt>Patients waiting</dt><dd>@AnalyticsPageViewModel.LittleCheck(m.LittleLqCheckPercent)</dd><span>@AnalyticsPageViewModel.Patients(m.LittleLq) worked out from arrivals × wait</span></div>
                <div><dt>Patients in the clinic</dt><dd>@AnalyticsPageViewModel.LittleCheck(m.LittleLsCheckPercent)</dd><span>@AnalyticsPageViewModel.Patients(m.LittleLs) worked out from arrivals × time in clinic</span></div>
            </dl>
        </section>
        <section>
            <h3>Model estimate (for comparison only)</h3>
            <p class="small text-secondary">What a standard waiting-line model expects for this doctor’s arrivals and consultation times. Real clinics book appointments, so the measured numbers above are the ones to trust.</p>
            @if (m.TheoreticalStatus == TheoreticalStatus.Computed)
            {
                <dl>
                    <div><dt>Expected wait before the doctor</dt><dd>@AnalyticsPageViewModel.Minutes(m.TheoreticalWqMinutes)</dd></div>
                    <div><dt>Expected total time in the clinic</dt><dd>@AnalyticsPageViewModel.Minutes(m.TheoreticalWsMinutes)</dd></div>
                    <div><dt>Expected patients waiting</dt><dd>@AnalyticsPageViewModel.Patients(m.TheoreticalLq)</dd></div>
                    <div><dt>Expected patients in the clinic</dt><dd>@AnalyticsPageViewModel.Patients(m.TheoreticalLs)</dd></div>
                </dl>
            }
            else if (m.TheoreticalStatus == TheoreticalStatus.Overloaded)
            {
                <div class="alert alert-danger py-2 small mb-0">@m.TheoreticalReason</div>
            }
            else
            {
                <div class="alert alert-secondary py-2 small mb-0">Not enough data yet. @m.TheoreticalReason</div>
            }
        </section>
        <section>
            <h3>Left out of the numbers</h3>
            <dl>
                <div><dt>Cancelled because the clinic was unavailable</dt><dd>@m.ExcludedClinicUnavailable</dd></div>
                <div><dt>Visits with missing or impossible times</dt><dd>@m.ExcludedInvalidTimestamps</dd></div>
                <div><dt>Consultations too long to be real</dt><dd>@m.ExcludedServiceAtOrAboveCap</dd><span>Usually a consultation nobody marked as finished</span></div>
            </dl>
        </section>
    </div>
</details>
