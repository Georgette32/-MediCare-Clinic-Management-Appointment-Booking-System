@using MediCare.Application.Analytics
@model MediCare.Web.Models.AnalyticsPageViewModel
@{
    ViewData["Title"] = "Queue analytics";
    var clinic = Model.Clinic;
}

<h1 class="mb-1">Queue analytics</h1>
<p class="text-secondary mb-3">How the clinic did on past days. For today, open the <a asp-controller="Analytics" asp-action="Live">Live board</a>.</p>

<form method="get" class="mc-panel mc-card d-flex flex-wrap gap-3 align-items-end mb-4">
    <div>
        <label class="form-label" for="from">From</label>
        <input class="form-control" type="date" id="from" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="form-label" for="to">To</label>
        <input class="form-control" type="date" id="to" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
    </div>
    <button class="btn btn-primary" type="submit">Show these days</button>
    <span class="form-text m-0">Starts with the last 30 days, up to yesterday.</span>
</form>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
else if (clinic is not null)
{
    var t = clinic.Totals;
    <div class="mc-stats mb-4">
        <div class="mc-panel mc-stat"><span class="mc-chip mc-chip-teal">@UiIcons.Icon("users")</span><div><b class="mc-num">@t.ArrivalsCount</b><span>Patients who came · @t.ServedCount seen</span></div></div>
        <div class="mc-panel mc-stat"><span class="mc-chip mc-chip-cobalt">@UiIcons.Icon("clock")</span><div><b class="mc-num">@AnalyticsPageViewModel.Percent(t.Utilization)</b><span>Time doctors spent with patients · @t.OpenHours.ToString("0") open hours</span></div></div>
        <div class="mc-panel mc-stat"><span class="mc-chip mc-chip-vermilion">@UiIcons.Icon("x")</span><div><b class="mc-num">@AnalyticsPageViewModel.Percent(t.NoShowRate)</b><span>No-shows · @t.NoShowCount of @t.NoShowDenominator appointments</span></div></div>
        <div class="mc-panel mc-stat"><span class="mc-chip mc-chip-amber">@UiIcons.Icon("walk")</span><div><b class="mc-num">@t.WalkInCompletedCount</b><span>Walk-ins seen · @AnalyticsPageViewModel.PerHour(t.WalkInPerHour)</span></div></div>
    </div>

    @if (clinic.Rows.Count == 0)
    {
        <p class="mc-empty">No doctor saw patients in these days. Try a longer period.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th class="text-end">Patients who came</th>
                        <th class="text-end">Patients seen</th>
                        <th>Workload</th>
                        <th class="text-end">Average wait</th>
                        <th class="text-end">Average time in clinic</th>
                        <th class="text-end">No-shows</th>
                        <th class="text-end" title="Joined the queue but left or were cancelled before seeing the doctor">Not seen</th>
                        <th class="text-end">Walk-ins per hour</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in clinic.Rows)
                    {
                        var m = row.Metrics;
                        <tr>
                            <td>
                                <a asp-action="Doctor" asp-route-id="@row.DoctorId" asp-route-from="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate.ToString("yyyy-MM-dd")">@row.DoctorName</a>
                                @if (row.SlotAdvice is { } advice)
                                {
                                    <div class="small text-secondary">Slot @advice.CurrentSlotMinutes min · average @advice.MeanServiceMinutes.ToString("0") min <span class="badge text-bg-warning ms-1">Check slot</span></div>
                                }
                            </td>
                            <td class="text-end">@m.ArrivalsCount</td>
                            <td class="text-end">@m.ServedCount</td>
                            <td><partial name="_Workload" model="(m.Rho, m.Overloaded)" /></td>
                            <td class="text-end">@AnalyticsPageViewModel.Minutes(m.MeasuredWqMinutes)</td>
                            <td class="text-end">@AnalyticsPageViewModel.Minutes(m.MeasuredWsMinutes)</td>
                            <td class="text-end">@AnalyticsPageViewModel.Percent(m.NoShowRate)</td>
                            <td class="text-end">@AnalyticsPageViewModel.Percent(m.NotSeenRate)</td>
                            <td class="text-end">@AnalyticsPageViewModel.PerHour(m.WalkInPerHour)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small text-secondary">
            <b>Workload</b> compares how fast patients arrived with how many the doctor can see: at 100% or more the waiting line keeps growing.
            Open a doctor for waits, consultation length and a check of how reliable the numbers are. All numbers come from the times recorded at the desk.
        </p>
    }
}
