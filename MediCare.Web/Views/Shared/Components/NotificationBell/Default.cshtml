@model int
@using MediCare.Web.Models
<a class="mc-bell-btn" asp-controller="Notifications" asp-action="Index"
   aria-label="Notifications, @Model unread" title="Notifications">
    @UiIcons.Icon("bell")
    @if (Model > 0)
    {
        <span class="mc-bell-count" aria-hidden="true">@(Model > 99 ? "99+" : Model.ToString())</span>
    }
</a>
