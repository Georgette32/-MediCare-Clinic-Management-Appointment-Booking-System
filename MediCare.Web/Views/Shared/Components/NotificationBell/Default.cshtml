@model int
<a class="btn btn-outline-secondary me-2 position-relative" asp-controller="Notifications" asp-action="Index"
   aria-label="Notifications, @Model unread" title="Notifications">
    <span aria-hidden="true">&#128276;</span>
    @if (Model > 0)
    {
        <span class="badge rounded-pill text-bg-danger">@(Model > 99 ? "99+" : Model.ToString())</span>
    }
</a>
