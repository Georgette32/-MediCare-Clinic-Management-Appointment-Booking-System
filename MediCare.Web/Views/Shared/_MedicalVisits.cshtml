@model IReadOnlyList<MediCare.Application.Services.MedicalRecordView>
@{
    var printBase = ViewData["PrintBase"] as string ?? "/";
}

@if (Model.Count == 0)
{
    <p class="text-secondary">No visits are recorded yet.</p>
}

@foreach (var visit in Model)
{
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between gap-2">
            <span><strong>@visit.VisitDate.ToString("D")</strong> &middot; @visit.DoctorName (@visit.Specialization)</span>
            @if (visit.Prescription is not null)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@printBase@visit.RecordId" target="_blank" rel="noopener">Print prescription</a>
            }
        </div>
        <div class="card-body">
            <dl class="row mb-2">
                <dt class="col-sm-3">Chief complaint</dt>
                <dd class="col-sm-9">@(visit.ChiefComplaint ?? "-")</dd>
                <dt class="col-sm-3">Diagnosis</dt>
                <dd class="col-sm-9">@visit.Diagnosis</dd>
                <dt class="col-sm-3">Clinical notes</dt>
                <dd class="col-sm-9">@(visit.ClinicalNotes ?? "-")</dd>
            </dl>

            @if (visit.Prescription is not null)
            {
                <h3 class="h6">Prescription</h3>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr><th>Medication</th><th>Dosage</th><th>Frequency</th><th>Days</th><th>Instructions</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var item in visit.Prescription.Items)
                        {
                            <tr>
                                <td>@item.MedicationName</td>
                                <td>@item.Dosage</td>
                                <td>@item.Frequency</td>
                                <td>@item.DurationDays</td>
                                <td>@(item.Instructions ?? "-")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active until @item.ActiveUntil.ToString("yyyy-MM-dd")</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Ended</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            @if (visit.Addenda.Count > 0)
            {
                <h3 class="h6">Addenda</h3>
                <ul class="list-unstyled mb-3">
                    @foreach (var addendum in visit.Addenda)
                    {
                        <li class="mb-2">
                            <div class="small text-secondary">@ClinicTime.Format(addendum.CreatedAtUtc, ClinicZone, "yyyy-MM-dd HH:mm") &middot; @addendum.DoctorName</div>
                            <div>@addendum.Text</div>
                        </li>
                    }
                </ul>
            }

            @await Html.PartialAsync("_MedicalAttachments", new MediCare.Web.Models.MedicalAttachmentPanel(visit, null, visit.PatientId))
        </div>
    </div>
}
