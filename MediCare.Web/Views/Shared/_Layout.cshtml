<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MediCare.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-toggleable-xl navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MediCare</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Doctors" asp-action="Index">Find a doctor</a></li>
                        }
                        @if (User.IsInRole(MediCare.Infrastructure.Identity.MediCareRoles.Patient))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Appointments" asp-action="Mine">My appointments</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Medical" asp-action="History">My medical history</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Medical" asp-action="ActivePrescriptions">Active prescriptions</a></li>
                        }
                        @if (User.IsInRole(MediCare.Infrastructure.Identity.MediCareRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="AdminAccounts" asp-action="Index">Staff accounts</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Staff">Staff</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Specializations">Specializations</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Settings">Settings</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="DoctorSchedule">Doctor schedules</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Analytics" asp-action="Index">Analytics</a></li>
                        }
                        @if (User.IsInRole(MediCare.Infrastructure.Identity.MediCareRoles.Receptionist) || User.IsInRole(MediCare.Infrastructure.Identity.MediCareRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reception" asp-action="Queue">Queue</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reception" asp-action="Appointments">Appointments</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reception" asp-action="Patients">Patients</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reception" asp-action="Index">Requests</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reception" asp-action="Extensions">Extensions</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reception" asp-action="Disruptions">Disruptions</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Analytics" asp-action="Live">Live board</a></li>
                        }
                        @if (User.IsInRole(MediCare.Infrastructure.Identity.MediCareRoles.Doctor))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Doctor" asp-action="Queue">My queue</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Doctor" asp-action="Schedule">My schedule</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Doctor" asp-action="Extensions">Extensions</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Doctor" asp-action="Statistics">My statistics</a></li>
                        }
                    </ul>
                    <div class="d-flex">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @await Component.InvokeAsync("NotificationBell")
                            <a class="btn btn-outline-secondary me-2" asp-controller="Account" asp-action="Profile">My profile</a>
                            <a class="btn btn-outline-secondary me-2" asp-controller="Account" asp-action="ChangePassword">Change password</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="btn btn-outline-secondary" type="submit">Sign out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Sign in</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 MediCare Clinic
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
