@model MediCare.Web.Models.AccountCreatedViewModel
@{
    ViewData["Title"] = "Password reset";
}
<h1 class="h3 mb-3">Password reset</h1>
<p>Give this temporary password directly to @Model.FullName. It is shown only on this page.</p>
<dl class="row">
    <dt class="col-sm-3">Role</dt><dd class="col-sm-9">@Model.Role</dd>
    <dt class="col-sm-3">Username</dt><dd class="col-sm-9"><code>@Model.UserName</code></dd>
    <dt class="col-sm-3">Temporary password</dt><dd class="col-sm-9"><code>@Model.TemporaryPassword</code></dd>
</dl>
<p class="text-warning">The previous password no longer works, existing sign-ins have ended, and the account must change this password at its next sign-in. Do not refresh or share this page.</p>
<a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Done</a>
