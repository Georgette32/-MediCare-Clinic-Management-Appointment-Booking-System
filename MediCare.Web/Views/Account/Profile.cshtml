@model MediCare.Web.Models.ProfilePageModel
@{
    ViewData["Title"] = "My profile";
    var profile = Model.Profile;
}

<h1 class="h3 mb-3">My profile</h1>
<partial name="_TempDataAlerts" />

<dl class="row mb-4">
    <dt class="col-sm-3">Full name</dt>
    <dd class="col-sm-9">@profile.FullName</dd>
    <dt class="col-sm-3">Username</dt>
    <dd class="col-sm-9">@profile.UserName</dd>
    <dt class="col-sm-3">Role</dt>
    <dd class="col-sm-9">@string.Join(", ", profile.Roles)</dd>
    @if (profile.IsPatient)
    {
        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@profile.PhoneNumber <span class="text-secondary small">(your username; it cannot be changed here)</span></dd>
    }
</dl>

<section class="card mb-4" style="max-width: 36rem">
    <div class="card-body">
        <h2 class="h5">Full name</h2>
        <form asp-action="ProfileName" method="post">
            <div class="mb-3">
                <label for="FullName" class="form-label">Full name</label>
                <input id="FullName" name="FullName" class="form-control" maxlength="200" required value="@Model.NameForm.FullName" />
            </div>
            <button type="submit" class="btn btn-primary">Save name</button>
        </form>
    </div>
</section>

<section class="card mb-4" style="max-width: 36rem">
    <div class="card-body">
        <h2 class="h5">Email</h2>
        @if (profile.IsPatient)
        {
            <form asp-action="ProfileEmail" method="post">
                <div class="mb-3">
                    <label for="Email" class="form-label">Email (optional)</label>
                    <input id="Email" name="Email" class="form-control" type="email" maxlength="256" value="@Model.EmailForm.Email" />
                    <div class="form-text">Leave blank to remove your email. Each email can belong to one account.</div>
                </div>
                <button type="submit" class="btn btn-primary">Save email</button>
            </form>
        }
        else
        {
            <p class="mb-0">@(profile.Email ?? "No email") <span class="text-secondary small">(your staff username; contact an administrator to change it)</span></p>
        }
    </div>
</section>

<section class="card" style="max-width: 36rem">
    <div class="card-body">
        <h2 class="h5">Password</h2>
        <a class="btn btn-outline-secondary" asp-action="ChangePassword">Change password</a>
    </div>
</section>
