@model MediCare.Web.Models.DoctorExtensionsViewModel
@using MediCare.Application.Services
@using MediCare.Domain.Enums
@{
    ViewData["Title"] = "Working-hour extensions";
}

<h1 class="h3 mb-3">Working-hour extensions</h1>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="mb-4">
    <h2 class="h5">Pending requests from reception</h2>
    @if (Model.Pending.Count == 0)
    {
        <p class="text-secondary">No pending requests.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>Date</th><th>Window end</th><th>Extend to</th><th>Reason</th><th>Requested (UTC)</th><th>Decision</th></tr>
                </thead>
                <tbody>
                @foreach (var request in Model.Pending)
                {
                    <tr>
                        <td>@request.Date.ToString("yyyy-MM-dd")</td>
                        <td>@request.OriginalEndTime.ToString("HH:mm")</td>
                        <td>@request.ExtendedEndTime.ToString("HH:mm")</td>
                        <td>@request.Reason</td>
                        <td>@request.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <form asp-action="DecideExtension" method="post" class="d-flex flex-wrap gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ExtensionId" value="@request.Id" />
                                <input type="text" name="Notes" maxlength="500" class="form-control form-control-sm" placeholder="Notes (optional)" />
                                <button type="submit" name="Approve" value="true" class="btn btn-success btn-sm">Approve</button>
                                <button type="submit" name="Approve" value="false" class="btn btn-outline-danger btn-sm">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="mb-4">
    <h2 class="h5">Add an extension to my schedule</h2>
    <p class="text-secondary small">An extension you record here is approved by you and is offered to patients immediately.</p>
    <form method="get" asp-action="Extensions" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label" for="pickDate">Date</label>
            <input id="pickDate" type="date" name="date" class="form-control" min="@Model.Today.ToString("yyyy-MM-dd")"
                   value="@((Model.SelectedDate ?? Model.Today).ToString("yyyy-MM-dd"))" required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Show working windows</button>
        </div>
    </form>

    @if (Model.SelectedDate is DateOnly selectedDate)
    {
        if (Model.WindowEnds.Count == 0)
        {
            <p class="text-secondary">You have no working window on @selectedDate.ToString("yyyy-MM-dd") (or it is a holiday).</p>
        }
        else
        {
            <form method="post" asp-action="CreateExtension" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                <div class="col-auto">
                    <label class="form-label" for="originalEnd">Window to extend</label>
                    <select id="originalEnd" name="OriginalEndTime" class="form-select" required>
                        @foreach (var end in Model.WindowEnds)
                        {
                            <option value="@end.ToString("HH:mm")">Ends @end.ToString("HH:mm")</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label" for="extendedEnd">New end time</label>
                    <input id="extendedEnd" type="time" name="ExtendedEndTime" class="form-control" required />
                </div>
                <div class="col">
                    <label class="form-label" for="extensionReason">Reason</label>
                    <input id="extensionReason" type="text" name="Reason" maxlength="500" class="form-control" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Record extension</button>
                </div>
            </form>
        }
    }
</section>

<section>
    <h2 class="h5">My extensions (last 30 days and upcoming)</h2>
    @if (Model.Own.Count == 0)
    {
        <p class="text-secondary">No extensions recorded.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>Date</th><th>Window end</th><th>Extended to</th><th>Reason</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Own)
                {
                    <tr>
                        <td>@item.Date.ToString("yyyy-MM-dd")</td>
                        <td>@item.OriginalEndTime.ToString("HH:mm")</td>
                        <td>@item.ExtendedEndTime.ToString("HH:mm")</td>
                        <td>@item.Reason</td>
                        <td>
                            @item.DisplayStatus
                            @if (!string.IsNullOrWhiteSpace(item.DecisionNotes))
                            {
                                <div class="small text-secondary">@item.DecisionNotes</div>
                            }
                        </td>
                        <td>
                            @if (!item.IsExpired && item.Status is WorkingHourExtensionStatus.Pending or WorkingHourExtensionStatus.Approved)
                            {
                                <form asp-action="CancelExtension" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="extensionId" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
