@model MediCare.Web.Models.DoctorSearchPageModel
@using MediCare.Web.Models
@{
    ViewData["Title"] = "Find a doctor";
    string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(part => char.IsLetter(part[0]) && !part.EndsWith('.') && part != "Dr").Take(2).Select(part => char.ToUpperInvariant(part[0])));
}

<div class="mc-page-head">
    <div>
        <h1>Find a doctor</h1>
        <p>@Model.Doctors.Count doctor@(Model.Doctors.Count == 1 ? "" : "s")@(Model.Date is DateOnly day ? $" · free times shown for {day:dddd d MMMM}" : ". Pick a day to see who has free times.")</p>
    </div>
</div>

<form method="get" asp-action="Index" class="mc-toolbar">
    <div class="mc-field-group">
        <label class="form-label" for="specializationFilter">Specialization</label>
        <select id="specializationFilter" name="specializationId" class="form-select" data-autosubmit>
            <option value="">All specializations</option>
            @foreach (var specialization in Model.Specializations)
            {
                <option value="@specialization.Id" selected="@(Model.SpecializationId == specialization.Id)">@specialization.Name</option>
            }
        </select>
    </div>
    <div class="mc-field-group">
        <label class="form-label" for="dateFilter">Day</label>
        <input id="dateFilter" type="date" name="date" class="form-control" value="@(Model.Date?.ToString("yyyy-MM-dd"))" data-autosubmit />
    </div>
    <div class="mc-field-group mc-grow">
        <label class="form-label" for="nameFilter">Doctor’s name</label>
        <div class="mc-search-field">
            @UiIcons.Icon("search", small: true)
            <input id="nameFilter" type="search" name="name" maxlength="200" class="form-control" value="@Model.Name" placeholder="e.g. Mariam" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
    @if (Model.SpecializationId is not null || !string.IsNullOrWhiteSpace(Model.Name) || Model.Date is not null)
    {
        <a class="btn btn-link" asp-action="Index">Clear</a>
    }
</form>

@if (Model.Doctors.Count == 0)
{
    <p class="mc-empty">No doctors match. Try another specialization or day, or <a asp-action="Index">clear the filters</a>.</p>
}
else
{
    <div class="mc-doctor-grid">
        @foreach (var doctor in Model.Doctors.OrderByDescending(item => Model.Date is not null && !item.IsHoliday && item.FreeSlots > 0))
        {
            <article class="mc-panel mc-doc-card">
                <div class="mc-doc-top">
                    <div class="mc-doc-mono" aria-hidden="true">@Initials(doctor.FullName)</div>
                    <div>
                        <h2>@doctor.FullName</h2>
                        <span class="mc-sub">@doctor.Specialization · @doctor.AppointmentDurationMinutes-minute visits</span>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(doctor.BiographyExcerpt))
                {
                    <p class="mc-doc-bio">@doctor.BiographyExcerpt</p>
                }
                <div class="mc-doc-foot">
                    @if (Model.Date is DateOnly)
                    {
                        @if (doctor.IsHoliday)
                        {
                            <span class="mc-badge mc-tone-slate">Away that day</span>
                        }
                        else if (doctor.FreeSlots == 0)
                        {
                            <span class="mc-badge mc-tone-slate">No free times that day</span>
                        }
                        else
                        {
                            <span class="mc-badge mc-tone-teal">@doctor.FreeSlots free time@(doctor.FreeSlots == 1 ? "" : "s")</span>
                        }
                    }
                    <a class="btn btn-sm @(Model.Date is DateOnly && !doctor.IsHoliday && doctor.FreeSlots > 0 ? "btn-primary" : "btn-outline-primary")" asp-action="Details" asp-route-id="@doctor.DoctorId"
                       asp-route-date="@(Model.Date?.ToString("yyyy-MM-dd"))">@(Model.Date is DateOnly ? "See times" : "View profile")</a>
                </div>
            </article>
        }
    </div>
}
