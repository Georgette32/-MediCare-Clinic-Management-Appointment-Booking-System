@model IReadOnlyList<MediCare.Application.Services.AppointmentRow>

@if (Model.Count == 0)
{
    <p class="text-secondary">Nothing to show.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Date and time</th>
                    <th>Doctor</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model)
            {
                var record = row.Record;
                <tr>
                    <td>
                        @record.Date.ToString("D")<br />
                        <span class="text-secondary">@record.StartTime.ToString("HH:mm")&ndash;@record.EndTime.ToString("HH:mm")</span>
                    </td>
                    <td>
                        @record.DoctorName<br />
                        <span class="text-secondary small">@record.Specialization</span>
                    </td>
                    <td><span class="badge text-bg-secondary">@record.Status</span></td>
                    <td class="small">
                        @if (record.OriginalDate is DateOnly originalDate && record.OriginalStartTime is TimeOnly originalStart)
                        {
                            <div>Reschedule of @originalDate.ToString("D") @originalStart.ToString("HH:mm")</div>
                        }
                        @if (row.LiveReplacement is { } replacement)
                        {
                            <div>Reschedule requested for @replacement.Date.ToString("D") @replacement.StartTime.ToString("HH:mm") (@replacement.Status)</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(record.CancellationReason))
                        {
                            <div>Reason: @record.CancellationReason</div>
                        }
                    </td>
                    <td class="text-end">
                        @if (row.CanPatientReschedule)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Reschedule" asp-route-id="@record.Id">Reschedule</a>
                        }
                        @if (row.CanPatientCancel)
                        {
                            <form asp-action="Cancel" method="post" class="d-inline-flex gap-1 mt-1">
                                <input type="hidden" name="AppointmentId" value="@record.Id" />
                                <input type="text" name="Reason" class="form-control form-control-sm" maxlength="500" placeholder="Reason (optional)" aria-label="Cancellation reason" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
