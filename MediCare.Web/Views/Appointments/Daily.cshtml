@model IReadOnlyList<MediCare.Domain.Appointment>
@{ ViewData["Title"] = "Daily schedule"; }
<h1>Daily schedule</h1>
<p>Times are shown in UTC.</p>
<p><a class="btn btn-outline-primary" asp-action="Calendar">Weekly calendar</a> <a class="btn btn-outline-secondary" asp-action="ScheduleSettings">Schedule settings</a></p>
<table class="table table-striped"><thead><tr><th>Time</th><th>Patient</th><th>Status</th><th>Check-in</th></tr></thead><tbody>
@foreach (var a in Model) { <tr><td>@a.ScheduledStart.ToString("t")–@a.ScheduledEnd.ToString("t")</td><td>@a.PatientId</td><td>@a.Status</td><td>@(a.CheckedInAt?.ToString("t") ?? "Not arrived")</td></tr> }
</tbody></table>
