@model MediCare.Web.Controllers.ScheduleSettingsInput
@using MediCare.Domain
@{ ViewData["Title"] = "Doctor scheduling settings"; var hours = ViewData["Hours"] as IReadOnlyList<DoctorWorkingHour> ?? []; var breaks = ViewData["Breaks"] as IReadOnlyList<DoctorBreak> ?? []; var leaves = ViewData["Leaves"] as IReadOnlyList<DoctorLeave> ?? []; }
<h1>Doctor schedule settings</h1>
@if (TempData["Message"] is string ok) { <div class="alert alert-success">@ok</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<section class="card mb-4"><div class="card-header">Scheduling defaults</div><div class="card-body"><form asp-action="SaveScheduleSettings" method="post" class="row g-3">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-4"><label asp-for="PublicDisplayName" class="form-label">Public display name</label><input asp-for="PublicDisplayName" class="form-control"/></div>
<div class="col-md-4"><label asp-for="Specialization" class="form-label">Specialization</label><input asp-for="Specialization" class="form-control"/></div>
<div class="col-md-4"><label asp-for="ConsultationFee" class="form-label">Consultation fee (optional)</label><input asp-for="ConsultationFee" class="form-control" step="0.01"/></div>
<div class="col-md-3"><label asp-for="DurationMinutes" class="form-label">Default consultation (minutes)</label><input asp-for="DurationMinutes" class="form-control"/><span asp-validation-for="DurationMinutes" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="GraceMultiplier" class="form-label">Grace multiplier (2 = twice duration)</label><input asp-for="GraceMultiplier" class="form-control" step="0.1"/><span asp-validation-for="GraceMultiplier" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="SafetyBufferMultiplier" class="form-label">Variability buffer multiplier</label><input asp-for="SafetyBufferMultiplier" class="form-control" step="0.1"/></div>
<div class="col-md-3"><label asp-for="MinimumSamples" class="form-label">Minimum completed visits</label><input asp-for="MinimumSamples" class="form-control"/></div>
<div class="col-md-3"><label asp-for="BookedCapacityReservation" class="form-label">Booked seats reserved (0–3)</label><input asp-for="BookedCapacityReservation" class="form-control"/></div>
<div class="col-12"><p class="text-muted mb-0">Call timeout is fixed at 5 minutes and room capacity at 3 seats.</p><button class="btn btn-primary mt-2">Save settings</button></div></form></div></section>

<section class="card mb-4"><div class="card-header">Regular working hours (UTC)</div><div class="card-body"><table class="table table-sm"><thead><tr><th>Day</th><th>Start</th><th>End</th></tr></thead><tbody>@foreach (var h in hours) { <tr><td>@h.DayOfWeek</td><td>@h.StartTime</td><td>@h.EndTime</td></tr> }</tbody></table>
<form asp-action="SaveWorkingHour" method="post" class="row g-2"><div class="col-md-4"><label class="form-label" for="day">Day</label><select id="day" name="day" class="form-select">@foreach (var d in Enum.GetValues<DayOfWeek>()) { <option value="@d">@d</option> }</select></div><div class="col-md-3"><label class="form-label" for="hourStart">Start</label><input id="hourStart" name="start" type="time" class="form-control" required/></div><div class="col-md-3"><label class="form-label" for="hourEnd">End</label><input id="hourEnd" name="end" type="time" class="form-control" required/></div><div class="col-md-2 align-self-end"><button class="btn btn-outline-primary">Save day</button></div></form></div></section>

<div class="row g-3"><section class="col-lg-6"><div class="card h-100"><div class="card-header">Breaks</div><div class="card-body"><ul>@foreach (var b in breaks) { <li>@(b.IsRecurring ? $"Every {b.RecurringDay}" : b.StartsAt.ToString("d")): @b.StartsAt.ToString("t")–@b.EndsAt.ToString("t") UTC</li> }</ul><form asp-action="AddBreak" method="post"><div class="mb-2"><label class="form-label">Starts (UTC)</label><input name="startsAt" type="datetime-local" class="form-control" required/></div><div class="mb-2"><label class="form-label">Ends (UTC)</label><input name="endsAt" type="datetime-local" class="form-control" required/></div><div class="form-check mb-2"><input type="checkbox" name="recurring" value="true" class="form-check-input" id="recurring"/><label class="form-check-label" for="recurring">Repeat weekly</label></div><div class="mb-2"><label class="form-label">Recurring weekday</label><select name="day" class="form-select"><option value="">One time</option>@foreach (var d in Enum.GetValues<DayOfWeek>()) { <option value="@d">@d</option> }</select></div><button class="btn btn-outline-primary">Add break</button></form></div></div></section>
<section class="col-lg-6"><div class="card h-100"><div class="card-header">Leave periods</div><div class="card-body"><ul>@foreach (var l in leaves) { <li>@l.StartsAt.ToString("g")–@l.EndsAt.ToString("g") UTC — @l.Reason (approved)</li> }</ul><form asp-action="AddLeave" method="post"><div class="mb-2"><label class="form-label">Starts (UTC)</label><input name="startsAt" type="datetime-local" class="form-control" required/></div><div class="mb-2"><label class="form-label">Ends (UTC)</label><input name="endsAt" type="datetime-local" class="form-control" required/></div><div class="mb-2"><label class="form-label">Reason</label><input name="reason" class="form-control" maxlength="250"/></div><button class="btn btn-outline-primary">Add approved leave</button></form></div></div></section></div>
