@model IReadOnlyList<MediCare.Application.DoctorDirectoryItem>
@{ ViewData["Title"] = "Find a doctor"; }
<h1>Find a doctor</h1>
<form method="get" class="row g-2 mb-3"><div class="col-auto"><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search name or doctor ID" aria-label="Search doctors"/></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button></div></form>
@if (Model.Count == 0) { <div class="alert alert-info">No doctor accounts found. Doctor accounts must be approved and assigned the Doctor role.</div> }
<div class="row row-cols-1 row-cols-md-2 g-3">
@foreach (var doctor in Model) { <div class="col"><div class="card h-100"><div class="card-body"><h2 class="h5">@doctor.DisplayName</h2>@if (!string.IsNullOrWhiteSpace(doctor.Specialization)) { <p>@doctor.Specialization</p> }@if (doctor.ConsultationFee is not null) { <p>Consultation fee: @doctor.ConsultationFee</p> }<p class="text-muted">Doctor ID: @doctor.DoctorId</p>@if (doctor.SchedulingConfigured) { <p>Default consultation: @doctor.DefaultConsultationDurationMinutes minutes</p><a class="btn btn-primary" asp-action="Book" asp-route-doctorId="@doctor.DoctorId">Choose available time</a> } else { <p class="text-warning">Scheduling not configured yet.</p> }</div></div></div> }
</div>
