@{ ViewData["Title"] = "Appointment calendar"; }
<h1>Appointment calendar</h1>
<p>Times shown in the clinic's configured time zone. The current standalone setup uses UTC.</p>
<div id="calendar" aria-label="Doctor appointment calendar"></div>
<div id="calendar-error" class="alert alert-danger d-none" role="alert"></div>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.1.3/all/global.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
    initialView: 'timeGridWeek', height: 'auto', nowIndicator: true,
    headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek' },
    events: '@Url.Action("CalendarEvents", "Appointments")',
    eventDidMount(info) { info.el.title = `${info.event.title} (${info.event.extendedProps.status})`; },
    eventSourceFailure() { const e = document.getElementById('calendar-error'); e.textContent = 'The appointment schedule could not be loaded.'; e.classList.remove('d-none'); }
  });
  calendar.render();
});
</script>
