@model IReadOnlyList<MediCare.Domain.AppointmentNotification>
@{ ViewData["Title"] = "Notifications"; }
<h1>Notifications</h1>
@if (Model.Count == 0) { <div class="alert alert-info">No notifications yet.</div> }
@foreach (var item in Model) { <article class="card mb-2 @(item.ReadAt is null ? "border-primary" : "")"><div class="card-body"><p>@item.Message</p><small class="text-muted">@item.CreatedAt.ToString("g") UTC</small>@if (item.ReadAt is null) { <form asp-action="MarkNotificationRead" method="post" class="d-inline ms-2"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-secondary">Mark read</button></form> }</div></article> }
