@model MediCare.Web.Models.PatientSearchModel
@{
    ViewData["Title"] = "Patients";
}

<h1 class="h3 mb-3">Patients</h1>
<partial name="_TempDataAlerts" />

<form method="get" asp-action="Patients" class="row g-2 align-items-start mb-4" novalidate>
    <div class="col-md-6">
        <label class="form-label" for="query">Phone or name</label>
        <input id="query" type="search" name="query" class="form-control@(Model.Problem is null ? "" : " mc-invalid")" value="@Model.Query" placeholder="e.g. 01012345678 or Sara"
               data-check="patient-search" aria-invalid="@(Model.Problem is null ? null : "true")" aria-describedby="query-help@(Model.Problem is null ? "" : " query-error")" />
        @if (Model.Problem is not null)
        {
            <span class="mc-field-msg" id="query-error" role="alert">@Model.Problem</span>
        }
        <div class="form-text" id="query-help">Full numbers accept Egyptian formats (01…, +20…, 0020…); 3 to 9 digits find numbers that contain them. Names match any part of the name.</div>
    </div>
    <div class="col-md-2" style="padding-top: 27px">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>

@if (string.IsNullOrWhiteSpace(Model.Query) || Model.Problem is not null)
{
    <p class="text-secondary">Search for a patient to view appointments or book one.</p>
}
else if (Model.Results.Count == 0)
{
    <p class="mc-empty">
        @if (Model.IsPartialPhone)
        {
            @:No patient’s number contains <b dir="ltr">@Model.Query!.Trim()</b>. Check the digits, or search by name.
        }
        else if (InputChecks.LooksLikePhone(Model.Query!.Trim()))
        {
            @:No patient is registered with <b dir="ltr">@Model.Query!.Trim()</b>. Check the number, or <a asp-action="CreatePatient">create a patient account</a>.
        }
        else
        {
            @:No patient’s name contains “@Model.Query!.Trim()”. Try part of the first or last name, or the mobile number.
        }
    </p>
}
else
{
    @if (Model.IsPartialPhone)
    {
        <p class="form-text mb-2">@UiIcons.Icon("info", small: true) Showing patients whose number contains <b dir="ltr">@Model.Query!.Trim()</b>.</p>
    }
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr><th>Name</th><th>Phone</th><th>Email</th><th><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
            @foreach (var patient in Model.Results)
            {
                <tr>
                    <td>@patient.FullName</td>
                    <td>@patient.PhoneNumber</td>
                    <td>@(patient.Email ?? "-")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="PatientDetail" asp-route-id="@patient.PatientId">Open</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
