@model IReadOnlyList<MediCare.Application.Services.PendingAppointmentDto>
@using MediCare.Web.Models
@{
    ViewData["Title"] = "Appointment requests";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var days = Model.OrderBy(item => item.Date).ThenBy(item => item.StartTime).GroupBy(item => item.Date).ToArray();
    var reschedules = Model.Count(item => item.OriginalDate is not null);
}

<div class="mc-page-head">
    <div>
        <h1>Requests</h1>
        <p>@(Model.Count == 0 ? "Nothing is waiting for you." : $"{Model.Count} request{(Model.Count == 1 ? "" : "s")} waiting for confirmation{(reschedules > 0 ? $", {reschedules} of them to move an appointment" : "")}. Patients are notified of your answer.")</p>
    </div>
    @if (User.IsInRole(MediCare.Infrastructure.Identity.MediCareRoles.Receptionist))
    {
        <div class="mc-page-act"><a class="btn btn-outline-secondary" asp-action="CreatePatient">@UiIcons.Icon("plus") Create patient account</a></div>
    }
</div>

<partial name="_TempDataAlerts" />

@if (Model.Count == 0)
{
    <p class="mc-empty">There are no requests to answer. New requests from patients appear here and in your notifications.</p>
}
else
{
    <div data-filter-scope>
        <div class="mc-toolbar mc-toolbar-sticky">
            <div class="mc-field-group mc-grow">
                <label class="form-label" for="find">Find a request</label>
                <div class="mc-search-field">
                    @UiIcons.Icon("search", small: true)
                    <input id="find" type="search" class="form-control" placeholder="Patient, mobile or doctor" data-filter-text autocomplete="off" />
                </div>
            </div>
        </div>

        @foreach (var day in days)
        {
            <h2 class="mc-day-head">@day.Key.ToString("dddd d MMMM") <span>@day.Count()</span></h2>
            <table class="mc-rows mc-requests mb-4">
                <thead><tr><th>Time</th><th>Patient</th><th>Doctor</th><th>Request</th><th class="mc-col-act"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var appointment in day)
                {
                    <tr data-filter-item data-status="" data-text="@appointment.PatientName @appointment.PatientPhone @appointment.DoctorName">
                        <td data-label="Time"><span class="mc-time">@appointment.StartTime.ToString("HH:mm")</span><span class="mc-sub">to @appointment.EndTime.ToString("HH:mm")</span></td>
                        <td data-label="Patient"><b>@appointment.PatientName</b><span class="mc-sub" dir="ltr">@appointment.PatientPhone</span></td>
                        <td data-label="Doctor">@appointment.DoctorName</td>
                        <td data-label="Request">
                            @if (appointment.OriginalDate is DateOnly originalDate && appointment.OriginalStartTime is TimeOnly originalStart)
                            {
                                <span class="mc-badge mc-tone-amber">Move an appointment</span>
                                <span class="mc-note">@UiIcons.Icon("clock", small: true) From @originalDate.ToString("ddd d MMM") at @originalStart.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="mc-badge mc-tone-teal">New appointment</span>
                            }
                        </td>
                        <td class="mc-col-act">
                            <div class="mc-row-act">
                                <form asp-action="Confirm" method="post">
                                    <input type="hidden" name="id" value="@appointment.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="btn btn-sm btn-primary" type="submit">@UiIcons.Icon("check", small: true) Confirm</button>
                                </form>
                                <form asp-action="Reject" method="post" data-confirm="Reject @appointment.PatientName’s request for @appointment.Date.ToString("d MMM") at @appointment.StartTime.ToString("HH:mm")? The patient will be notified.">
                                    <input type="hidden" name="id" value="@appointment.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Reject</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        <p class="mc-empty" data-filter-empty hidden>No request matches your search.</p>
    </div>
}
