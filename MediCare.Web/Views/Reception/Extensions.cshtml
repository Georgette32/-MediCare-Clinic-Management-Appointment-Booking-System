@model MediCare.Web.Models.ReceptionExtensionsViewModel
@using MediCare.Application.Services
@using MediCare.Domain.Enums
@{
    ViewData["Title"] = "Working-hour extensions";
    var selectedDate = Model.SelectedDate ?? Model.Today;
}

<h1 class="h3 mb-3">Working-hour extensions</h1>
<p class="text-secondary small">Reception records a request only. The doctor must approve it before any extra availability is offered.</p>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form method="get" asp-action="Extensions" class="row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label class="form-label" for="doctorPick">Doctor</label>
        <select id="doctorPick" name="doctorId" class="form-select" required>
            <option value="">Choose a doctor</option>
            @foreach (var doctor in Model.Doctors)
            {
                <option value="@doctor.DoctorId" selected="@(Model.SelectedDoctorId == doctor.DoctorId)">@doctor.FullName</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="pickDate">Date</label>
        <input id="pickDate" type="date" name="date" class="form-control" value="@selectedDate.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Show</button>
    </div>
</form>

@if (Model.SelectedDoctorId is Guid doctorId)
{
    <section class="mb-4">
        <h2 class="h5">Request an extension</h2>
        @if (Model.WindowEnds.Count == 0)
        {
            <p class="text-secondary">This doctor has no working window on @selectedDate.ToString("yyyy-MM-dd") (or it is a holiday).</p>
        }
        else
        {
            <form method="post" asp-action="RequestExtension" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DoctorId" value="@doctorId" />
                <input type="hidden" name="Date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                <div class="col-md-3">
                    <label class="form-label" for="originalEnd">Window to extend</label>
                    <select id="originalEnd" name="OriginalEndTime" class="form-select" required>
                        @foreach (var end in Model.WindowEnds)
                        {
                            <option value="@end.ToString("HH:mm")">Ends @end.ToString("HH:mm")</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="extendedEnd">New end time</label>
                    <input id="extendedEnd" type="time" name="ExtendedEndTime" class="form-control" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="extensionReason">Reason</label>
                    <input id="extensionReason" type="text" name="Reason" maxlength="500" class="form-control" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Send request</button>
                </div>
            </form>
        }
    </section>

    <section>
        <h2 class="h5">Extensions for this doctor (last 30 days and upcoming)</h2>
        @if (Model.Extensions.Count == 0)
        {
            <p class="text-secondary">No extensions recorded.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Date</th><th>Window end</th><th>Extended to</th><th>Reason</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Extensions)
                    {
                        <tr>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td>@item.OriginalEndTime.ToString("HH:mm")</td>
                            <td>@item.ExtendedEndTime.ToString("HH:mm")</td>
                            <td>@item.Reason</td>
                            <td>
                                @item.DisplayStatus
                                @if (!string.IsNullOrWhiteSpace(item.DecisionNotes))
                                {
                                    <div class="small text-secondary">@item.DecisionNotes</div>
                                }
                            </td>
                            <td>
                                @if (!item.IsExpired && item.Status == WorkingHourExtensionStatus.Pending)
                                {
                                    <form asp-action="CancelExtension" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="extensionId" value="@item.Id" />
                                        <input type="hidden" name="doctorId" value="@doctorId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Cancel request</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
