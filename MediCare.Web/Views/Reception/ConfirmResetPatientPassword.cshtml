@model MediCare.Web.Models.PasswordResetConfirmModel
@{
    ViewData["Title"] = "Reset patient password";
}

<p class="mb-2"><a asp-action="PatientDetail" asp-route-id="@Model.Id">&larr; @Model.FullName</a></p>
<h1 class="h3 mb-3">Reset password for @Model.FullName?</h1>
<div class="alert alert-warning">
    <p class="mb-2"><strong>Verify the patient's identity in person before resetting.</strong></p>
    <ul class="mb-0">
        <li>Generate a new temporary password, shown once on the next page.</li>
        <li>End every current sign-in for this patient's account.</li>
        <li>Require the patient to change the password at the next sign-in.</li>
        <li>Clear any lockout from failed attempts.</li>
    </ul>
</div>
<p class="text-secondary">Sign-in phone: <code>@Model.UserName</code>. Give the temporary password to the patient in person.</p>
<form method="post" asp-action="ResetPatientPassword" class="d-flex gap-2">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Reset password</button>
    <a class="btn btn-outline-secondary" asp-action="PatientDetail" asp-route-id="@Model.Id">Cancel</a>
</form>
