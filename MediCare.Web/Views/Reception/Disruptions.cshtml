@model MediCare.Web.Models.DisruptionsPageViewModel
@{
    ViewData["Title"] = "Doctor disruptions";
}

<h1 class="h3 mb-3">Doctor disruptions</h1>
<p class="text-secondary small">Use this when a doctor must leave before the end of the working day. Recording blocks the doctor's remaining time on that date and builds a worklist. It does not change working hours.</p>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="mb-4">
    <h2 class="h5">Record a disruption</h2>
    @if (Model.Doctors.Count == 0)
    {
        <p class="text-secondary">There are no active doctors.</p>
    }
    else
    {
        <form method="post" asp-action="RecordDisruption" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label" for="disruptionDoctor">Doctor</label>
                <select id="disruptionDoctor" name="DoctorId" class="form-select" required>
                    <option value="">Choose a doctor</option>
                    @foreach (var doctor in Model.Doctors)
                    {
                        <option value="@doctor.DoctorId">@doctor.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="disruptionDate">Date</label>
                <input id="disruptionDate" type="date" name="Date" class="form-control" value="@Model.Today.ToString("yyyy-MM-dd")" min="@Model.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="disruptionFrom">Leaves at</label>
                <input id="disruptionFrom" type="time" name="FromTime" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="disruptionReason">Reason</label>
                <input id="disruptionReason" type="text" name="Reason" maxlength="500" class="form-control" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-danger">Record disruption</button>
            </div>
        </form>
    }
</section>

<section>
    <h2 class="h5">Recent disruptions</h2>
    @if (Model.Recent.Count == 0)
    {
        <p class="text-secondary">No disruptions recorded.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>Date</th><th>Doctor</th><th>Leaves at</th><th>Reason</th><th>Recorded (UTC)</th><th>Day end</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Recent)
                {
                    <tr>
                        <td>@item.Date.ToString("yyyy-MM-dd")</td>
                        <td>@item.DoctorName</td>
                        <td>@item.FromTime.ToString("HH:mm")</td>
                        <td>@item.Reason</td>
                        <td>@item.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(item.DayEndRecorded ? "Recorded" : "Not recorded")</td>
                        <td><a asp-action="Disruption" asp-route-id="@item.Id">Open worklist</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
