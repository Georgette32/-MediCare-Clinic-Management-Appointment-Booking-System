@model MediCare.Web.Models.NotificationsPageModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Notifications</h1>
    <form asp-action="MarkAllRead" method="post">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Mark all read</button>
    </form>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}

@if (Model.Items.Count == 0)
{
    <p class="text-secondary">You have no notifications yet.</p>
}
else
{
    <div class="list-group mb-3">
        @foreach (var item in Model.Items)
        {
            <div class="list-group-item @(item.IsUnread ? "list-group-item-warning" : "")">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <form asp-action="Open" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link p-0 text-start fw-@(item.IsUnread ? "bold" : "normal") text-decoration-none">
                                @item.Title
                            </button>
                        </form>
                        @if (item.IsUnread)
                        {
                            <span class="badge text-bg-warning ms-1">New</span>
                        }
                        <div class="small">@item.Message</div>
                        @if (item.Link is null)
                        {
                            <div class="small text-secondary">No related page is available for your role.</div>
                        }
                    </div>
                    <div class="small text-secondary text-nowrap">@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Notification pages">
        <ul class="pagination pagination-sm">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

<p class="small text-secondary">Notifications are refreshed when you reload this page. Opening one marks it as read.</p>
