@model MediCare.Web.Models.NotificationsPageModel
@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Items.Count(item => item.IsUnread);
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="mb-1">Notifications</h1>
        <p class="text-secondary mb-0">@(unread == 0 ? "You’re up to date." : $"{unread} new.") Open one to go to the page it is about.</p>
    </div>
    @if (unread > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Mark all as read</button>
        </form>
    }
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}

@if (Model.Items.Count == 0)
{
    <p class="mc-empty">You have no notifications yet. Messages about your appointments and requests will appear here.</p>
}
else
{
    <ul class="mc-notes">
        @foreach (var item in Model.Items)
        {
            <li><partial name="_NotificationItem" model="item" /></li>
        }
    </ul>
    @if (Model.HasOlder)
    {
        <p class="small text-secondary mt-3">Showing your latest @Model.Items.Count of @Model.TotalCount notifications.</p>
    }
}
