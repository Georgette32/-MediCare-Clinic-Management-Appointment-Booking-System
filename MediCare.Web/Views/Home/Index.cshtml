@using MediCare.Infrastructure.Identity
@{
    ViewData["Title"] = "MediCare";
}

<div class="py-4">
    <p class="text-primary fw-semibold text-uppercase small mb-2">Clinic operations</p>
    <h1 class="display-6 fw-semibold">Care that keeps moving.</h1>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <p class="lead text-secondary col-lg-7">Find a doctor and book an appointment, or sign in to manage your clinic work.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Create a patient account</a>
        </div>
    }
    else
    {
        <p class="lead text-secondary col-lg-7">Choose a task below to continue.</p>
        <div class="list-group col-lg-6">
            <a class="list-group-item list-group-item-action" asp-controller="Doctors" asp-action="Index">Find a doctor</a>

            @if (User.IsInRole(MediCareRoles.Patient))
            {
                <a class="list-group-item list-group-item-action" asp-controller="Appointments" asp-action="Mine">My appointments</a>
            }
            <a class="list-group-item list-group-item-action" asp-controller="Account" asp-action="Profile">My profile</a>

            @if (User.IsInRole(MediCareRoles.Doctor))
            {
                <a class="list-group-item list-group-item-action" asp-controller="Doctor" asp-action="Queue">My queue</a>
                <a class="list-group-item list-group-item-action" asp-controller="Doctor" asp-action="Schedule">My schedule</a>
                <a class="list-group-item list-group-item-action" asp-controller="Doctor" asp-action="Extensions">Working-hour extensions</a>
            }
            @if (User.IsInRole(MediCareRoles.Receptionist) || User.IsInRole(MediCareRoles.Admin))
            {
                <a class="list-group-item list-group-item-action" asp-controller="Reception" asp-action="Queue">Queue</a>
                <a class="list-group-item list-group-item-action" asp-controller="Reception" asp-action="Appointments">Appointments</a>
                <a class="list-group-item list-group-item-action" asp-controller="Reception" asp-action="Patients">Patients</a>
                <a class="list-group-item list-group-item-action" asp-controller="Reception" asp-action="Index">Requests</a>
                <a class="list-group-item list-group-item-action" asp-controller="Reception" asp-action="Disruptions">Disruptions</a>
                <a class="list-group-item list-group-item-action" asp-controller="Reception" asp-action="Extensions">Extensions</a>
            }
            @if (User.IsInRole(MediCareRoles.Admin))
            {
                <a class="list-group-item list-group-item-action" asp-controller="AdminAccounts" asp-action="Index">Staff accounts</a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Staff">Staff activation</a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Specializations">Specializations</a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="DoctorSchedule">Doctor schedules</a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Settings">Clinic settings</a>
            }
        </div>
    }
</div>
