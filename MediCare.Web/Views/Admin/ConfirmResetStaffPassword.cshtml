@model MediCare.Web.Models.PasswordResetConfirmModel
@{
    ViewData["Title"] = "Reset password";
}

<h1 class="h3 mb-3">Reset password for @Model.FullName?</h1>
<div class="alert alert-warning">
    <p class="mb-2">Resetting this @Model.Role account's password will:</p>
    <ul class="mb-0">
        <li>Generate a new temporary password, shown once on the next page.</li>
        <li>End every current sign-in for this account.</li>
        <li>Require the account to change the password at its next sign-in.</li>
        <li>Clear any lockout from failed attempts.</li>
    </ul>
</div>
<p class="text-secondary">Username: <code>@Model.UserName</code>. Give the temporary password to the staff member directly.</p>
<form method="post" asp-action="ResetStaffPassword" class="d-flex gap-2">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Reset password</button>
    <a class="btn btn-outline-secondary" asp-action="Staff">Cancel</a>
</form>
