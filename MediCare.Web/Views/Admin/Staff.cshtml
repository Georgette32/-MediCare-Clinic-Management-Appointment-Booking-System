@model IReadOnlyList<MediCare.Application.Abstractions.StaffAccountRow>
@{
    ViewData["Title"] = "Staff";
}

<div class="mc-page-head">
    <div>
        <h1>Staff</h1>
        <p>Create doctor and reception accounts, reset passwords and control who can sign in.</p>
    </div>
    <div class="mc-page-act">
        <a class="btn btn-outline-secondary" asp-controller="AdminAccounts" asp-action="Receptionist">@MediCare.Web.Models.UiIcons.Icon("plus") Add receptionist</a>
        <a class="btn btn-primary" asp-controller="AdminAccounts" asp-action="Doctor">@MediCare.Web.Models.UiIcons.Icon("plus") Add doctor</a>
    </div>
</div>
<p class="text-secondary">Deactivating an account blocks sign-in immediately. Deactivating a doctor also hides them from discovery and booking, cancels their future appointments and waiting entries (reason: doctor no longer available), and notifies each patient. A doctor with a patient in consultation cannot be deactivated.</p>
<partial name="_TempDataAlerts" />

<div class="table-responsive">
    <table class="mc-rows">
        <thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Specialization</th><th>Status</th><th class="mc-col-act"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        @foreach (var account in Model)
        {
            <tr>
                <td data-label="Name"><b class="text-nowrap">@account.FullName</b></td>
                <td data-label="Username">@account.UserName</td>
                <td data-label="Role">@account.Role</td>
                <td data-label="Specialization">@(account.Specialization ?? "-")</td>
                <td data-label="Status">
                    @if (account.IsActive)
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactive</span>
                    }
                </td>
                <td class="mc-col-act">
                    <div class="d-flex flex-wrap flex-md-nowrap gap-2 justify-content-md-end text-nowrap">
                    @if (account.IsActive && (account.Role == "Doctor" || account.Role == "Receptionist"))
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="ConfirmResetStaffPassword" asp-route-userId="@account.UserId">Reset password…</a>
                    }
                    @if (account.IsActive && account.Role == "Doctor")
                    {
                        <a class="btn btn-sm btn-outline-danger" asp-action="ConfirmDeactivateStaff" asp-route-userId="@account.UserId">Deactivate…</a>
                    }
                    else
                    {
                        <form method="post" asp-action="SetStaffActive" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@account.UserId" />
                            <input type="hidden" name="isActive" value="@(account.IsActive ? "false" : "true")" />
                            <button type="submit" class="btn btn-sm @(account.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(account.IsActive ? "Deactivate" : "Reactivate")
                            </button>
                        </form>
                    }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
