@model MediCare.Web.Models.SpecializationsPageModel
@{
    ViewData["Title"] = "Specializations";
}

<h1 class="h3 mb-3">Specializations</h1>
<partial name="_TempDataAlerts" />

<section class="card mb-4">
    <div class="card-header fw-semibold">Add a specialization</div>
    <div class="card-body">
        <form method="post" asp-action="CreateSpecialization" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label" for="newSpecializationName">Name</label>
                <input id="newSpecializationName" type="text" name="Name" maxlength="120" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="newSpecializationDescription">Description (optional)</label>
                <input id="newSpecializationDescription" type="text" name="Description" maxlength="2000" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Add</button>
            </div>
        </form>
    </div>
</section>

<section class="card">
    <div class="card-header fw-semibold">Existing specializations</div>
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <p class="text-secondary">No specializations yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mc-window-table">
                    <thead><tr><th>Name</th><th>Description</th><th>Doctors</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var editForm = $"edit-{item.Id}";
                        <tr>
                            <td><input form="@editForm" type="text" name="Name" maxlength="120" class="form-control form-control-sm" value="@item.Name" required aria-label="Name" /></td>
                            <td class="mc-spec-desc"><input form="@editForm" type="text" name="Description" maxlength="2000" class="form-control form-control-sm" value="@item.Description" aria-label="Description of @item.Name" placeholder="Description" /></td>
                            <td class="small text-secondary text-nowrap">@item.DoctorCount doctor@(item.DoctorCount == 1 ? "" : "s")</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-end">
                                    <form id="@editForm" method="post" asp-action="UpdateSpecialization" asp-route-specializationId="@item.Id" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                    </form>
                                    <form method="post" asp-action="DeleteSpecialization" class="m-0" data-confirm="Delete @item.Name?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="specializationId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" disabled="@(item.DoctorCount > 0)"
                                                title="@(item.DoctorCount > 0 ? "A specialization in use by doctors cannot be deleted." : "Delete this specialization")">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
