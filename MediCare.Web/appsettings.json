{
  "Clinic": {
    "Maintenance": {
      "IntervalMinutes": 5
    }
  },
  "MedicalFiles": {
    "StoragePath": "App_Data/medical-files",
    "MaxFileSizeBytes": 10485760
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 3600
    }
  },
  "AllowedHosts": "*"
}
